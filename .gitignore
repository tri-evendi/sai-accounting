# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/dist
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
# Klien basis data kendali (issue #104) — sama seperti klien perusahaan, dihasilkan
# oleh `npm run db:generate`, bukan disimpan di repo.
/src/generated/control

# local audit trail (sensitive)
# Sejak #104 jejak audit pindah ke `data/audit/<slug>/audit.jsonl` — satu
# tingkat lebih dalam, sehingga pola lama `/data/audit/*.jsonl` berhenti cocok
# dan berkasnya muncul sebagai untracked yang siap ikut ter-commit. Isinya
# username, peran, dan alamat IP sungguhan. Diabaikan per-folder, bukan
# per-berkas, supaya penambahan PT berikutnya tidak perlu diingat lagi.
/data/audit/

# runtime logs
/logs/

# database dumps (never commit production data)
*.sql
!prisma/migrations/**/*.sql
# Sejak #104 ada DUA folder migration. Tanpa baris ini, `*.sql` di atas menelan
# migration basis data KENDALI: repo mengira dirinya lengkap, lalu
# `db:migrate:control` di mesin baru berhenti dengan "No migration found".
!prisma/control/migrations/**/*.sql

# transient agent worktrees
/.claude/worktrees/

# python caches from local tooling/skills
__pycache__/
*.pyc

# Local DB dumps / backups — never commit
backups/
