# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# bun workspaces: setiap paket & aplikasi punya node_modules sendiri, dan pola
# berjangkar (`/node_modules`) tidak menjangkaunya.
node_modules/
/dist
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Keluaran build konsol operator (monorepo Fase 3d) — `/.next/` di atas berjangkar ke akar.
/apps/*/.next/
/apps/*/next-env.d.ts
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# … kecuali CONTOHNYA (#159 temuan 6): README & scripts/setup.sh menyuruh
# `cp .env.example .env`, tapi pola `.env*` di atas diam-diam menelan berkas
# contohnya sendiri — clone baru tidak pernah menerimanya.
!.env.example
!.env.docker.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
# Klien basis data kendali (issue #104) — sama seperti klien perusahaan, dihasilkan
# oleh `npm run db:generate`, bukan disimpan di repo.
/src/generated/control
# Klien basis data platform (issue #137) — idem.
/src/generated/platform
# ...dan direktori INDUKNYA, yang selama ini tidak disebut. Worktree agent tidak
# punya klien hasil generate (tsc memuntahkan ~200 galat palsu tanpanya), jadi
# yang biasa dilakukan adalah men-symlink `src/generated` ke checkout utama —
# lalu satu `git add -A` menjadikan symlink itu commit, dan di checkout utama ia
# menunjuk dirinya sendiri: klien Prisma lenyap, 24 berkas tes merah, dan
# penyebabnya tidak terlihat di diff mana pun. Terjadi sungguhan sebelum
# `Merge PR #236`.
/src/generated/
# Sejak monorepo Fase 1b (17 Okt 2026) ketiga klien dibangkitkan ke
# `packages/db/generated/{company,control,platform}`. Baris `src/generated` di atas
# tetap ada untuk checkout/worktree lama yang masih menyimpannya. TANPA garis
# miring di ujung: pola ber-`/` hanya cocok dengan DIREKTORI, dan symlink yang
# dijelaskan di atas adalah berkas.
/packages/db/generated

# local audit trail (sensitive)
# Sejak #104 jejak audit pindah ke `data/audit/<slug>/audit.jsonl` — satu
# tingkat lebih dalam, sehingga pola lama `/data/audit/*.jsonl` berhenti cocok
# dan berkasnya muncul sebagai untracked yang siap ikut ter-commit. Isinya
# username, peran, dan alamat IP sungguhan. Diabaikan per-folder, bukan
# per-berkas, supaya penambahan PT berikutnya tidak perlu diingat lagi.
/data/audit/

# runtime logs
/logs/

# database dumps (never commit production data)
*.sql
# Riwayat migration MariaDB (perusahaan/kendali/platform), ARSIP hanya-baca
# sejak #636. Dulu tiga baris terpisah — `prisma/migrations`, lalu kendali
# (#104), lalu platform (#137) — masing-masing lahir dari folder yang ditelan
# `*.sql` di atas tanpa suara.
!prisma/_arsip-mariadb/**/*.sql
# Dan sejak 12 Okt 2026 ada baseline PostgreSQL yang DIBANGKITKAN
# (`bun run pg:baseline`). Ia tertangkap `*.sql` di atas — dan tertangkapnya
# tidak terlihat: `git add -A` berhasil tanpa keluhan, lalu baseline-nya hilang
# dari repo dan baru ketahuan pada hari penukaran. Pola yang persis sama dengan
# dua baris di atas, yang masing-masing lahir dari kejadian yang sama.
!prisma/postgresql/**/*.sql
# Kueri sumber `sqlc` (09 §3.5): `contract/jobs.sql` + `contract/trail.sql`.
# Kejadian KEEMPAT pola yang sama (23 Okt 2026): tertelan `*.sql` di atas,
# bangkitan + `sqlc.sum`-nya ter-commit tanpa sumbernya, dan `contract:gen
# --cek` merah di CI saja. Dijaga `tests/services-go.test.ts`.
!contract/*.sql

# transient agent worktrees
/.claude/worktrees/

# python caches from local tooling/skills
__pycache__/
*.pyc

# Local DB dumps / backups — never commit
backups/
# Bundel serah-terima on-premise (`tenant:export-onprem`) & direktori kerjanya:
# seluruh buku satu tenant + hash kata sandi penggunanya.
*.saibundle
*.pgdump
/data/cadangan/

# Keadaan RUNTIME di dalam `data/`, bukan kode.
#   mail-outbox/  surel yang DITANGKAP transport `file` (MAIL_TRANSPORT=file);
#                 pada pemasangan nyata isinya alamat & badan surel sungguhan.
#   *.log         log server.
# ⚠ Sengaja BUKAN `/data/` polos: `data/audit/.gitkeep` memang terlacak supaya
# direktorinya ada sejak checkout pertama.
/data/mail-outbox/
/data/*.log
# hasil/     berkas hasil pekerjaan (`result_ref`) — ekspor laporan, dokumen.
#            Isinya buku besar PT sungguhan, dan satu-satunya jalan keluarnya
#            route handler ber-izin. Ia TIDAK boleh ikut ke konteks build:
#            satu dump produksi pernah terpanggang ke dalam image karena
#            direktori runtime di pohon repo (lihat .dockerignore §anchor).
/data/hasil/

# Berkas referensi pihak ketiga (ekspor Accurate, terbitan Pajakku, dll).
# Sebagian berisi buku besar SUNGGUHAN milik PT pelanggan. `docs/accurate-reference.md`
# sudah menetapkan bahwa nilai spesifik PT tidak disimpan di repo — hanya
# struktur & aturannya — dan fixture tes memakai data SINTETIS, bukan berkas ini.
# Sekali terdorong ke remote ia tetap ada di riwayat meski dihapus.
/data/referensi/
