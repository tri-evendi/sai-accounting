// ─────────────────────────────────────────────────────────────────────────────
// BASIS DATA KENDALI (control database) — issue #104
//
// Satu basis data kecil yang TIDAK berisi angka akuntansi apa pun. Isinya hanya
// tiga hal: siapa penggunanya, ada perusahaan apa saja, dan siapa boleh masuk ke
// perusahaan yang mana. Seluruh buku besar — jurnal, faktur, stok, kas — hidup di
// basis data MILIK PERUSAHAAN masing-masing (`prisma/schema.prisma`), satu basis
// data per PT, tanpa satu pun kolom `company_id`.
//
// KENAPA DIPISAH BEGINI. Isolasinya FISIK, bukan sekadar teruji: satu klausa
// `WHERE company_id = …` yang terlupa pada tenancy per-baris akan menampilkan
// buku besar satu klien kepada klien lain — di produk akuntansi itu bukan bug,
// itu insiden. Dengan basis data terpisah kebocoran seperti itu TIDAK MUNGKIN
// terjadi, bukan "tidak terjadi karena tesnya lengkap". Preseden yang sudah
// dikenal akuntan Indonesia: berkas perusahaan Accurate/MYOB.
//
// KENAPA IDENTITAS ADA DI SINI, BUKAN DI TIAP PERUSAHAAN. Kalau `users` hidup di
// dalam basis data tiap perusahaan, satu orang punya beberapa akun terpisah
// dengan kata sandi terpisah — dan "satu login mencakup semua perusahaan", yang
// merupakan seluruh alasan issue #104 ada, menjadi mustahil. Ongkosnya satu
// basis data lagi untuk dikelola; itu harga yang dibayar sadar-sadar.
//
// AKIBATNYA, dan ini disengaja: tabel di basis data perusahaan TIDAK BOLEH punya
// foreign key ke `users`. `periods.closed_by_id` dan `user_permission_overrides.
// user_id` menyimpan id pengguna GLOBAL sebagai angka biasa, tanpa FK — sebab FK
// tidak bisa menyeberangi basis data. Penegakannya pindah ke lapisan aplikasi.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../../generated/control"
}

datasource db {
  provider = "postgresql"
}

/// PELANGGAN platform (issue #134, epik #133) — pihak yang berlangganan dan
/// membayar. Satu tenant memegang beberapa Company (PT) dan beberapa User.
///
/// KENAPA DI BASIS DATA KENDALI, BUKAN DI `sai_platform`: `tenants` dibaca di
/// jalur panas (pengguna ini tenant mana → perusahaan apa saja → apakah
/// suspended), dan pendaftaran harus atomik — Tenant + User(owner) +
/// TenantMembership lahir dalam SATU transaksi. Lihat docs/MULTI-TENANT.md §4A.
model Tenant {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  /// Kapan slug terakhir diganti (#458) — dasar pagar "sekali per 30 hari".
  /// NULL = belum pernah. Pagarnya ada karena setiap penggantian memesan satu
  /// slug selamanya DAN memutus tautan yang belum sempat diperbarui siapa pun.
  slugChangedAt DateTime? @map("slug_changed_at")

  name String @db.VarChar(150)

  /// pending_verification | trialing | active | past_due | suspended | cancelled
  /// | migrated_out (pindah ke on-premise, migration kendali 0010)
  /// | trial_ended (uji coba habis → beku hanya-baca, alur demo-first)
  /// String + z.enum (`TENANT_STATUSES` di src/lib/constants.ts), snake_case —
  /// konvensi docs/DATABASE.md, bukan enum Prisma.
  status String @default("pending_verification") @db.VarChar(30)

  planKey     String    @default("trial") @map("plan_key") @db.VarChar(30)
  trialEndsAt DateTime? @map("trial_ends_at")

  /// Batas dari paket, DISALIN saat paket berubah — bukan dibaca dari tabel
  /// paket saat dipakai. Alasannya sama dengan snapshot peran penyetuju di
  /// aturan persetujuan: menaikkan harga paket tidak boleh diam-diam
  /// mempersempit pelanggan yang sudah berjalan.
  maxCompanies Int @default(1) @map("max_companies")
  maxUsers     Int @default(3) @map("max_users")

  /// PEMBEKUAN serah-terima ke on-premise (migration kendali 0010). Bukan
  /// NULL = seluruh buku tenant ini HANYA-BACA, apa pun status langganannya.
  /// Kolom sendiri, BUKAN nilai `status`: `status` adalah salinan status
  /// langganan yang ditulis ulang mesin penagihan (penjadwal, webhook, konsol),
  /// jadi pembekuan yang disimpan di sana bisa dicairkan diam-diam oleh
  /// putaran penjadwal di tengah ekspor — dan tulisan yang lolos sesudah dump
  /// adalah tulisan yang hilang. Ditulis `tenant:export-onprem`, dicabut
  /// `tenant:unfreeze` (jalan balik).
  frozenAt DateTime? @map("frozen_at")

  /// Kapan tenant dinyatakan `migrated_out` (`tenant:mark-migrated-out`).
  migratedOutAt DateTime? @map("migrated_out_at")

  /// Mitra yang MEMBAWA tenant ini (migration kendali 0013, alur demo-first) —
  /// teks bebas, sengaja bukan tabel mitra: tujuannya satu, yaitu komisi yang
  /// dihitung MANUAL dari daftar tenant. Ditulis konsol operator (beralasan,
  /// berjejak). NULL = datang sendiri / tidak diketahui.
  referredByPartner String? @map("referred_by_partner") @db.VarChar(100)

  /// Tenant DEMO (migration kendali 0013): boleh diisi ulang data contoh oleh
  /// `bun run demo:seed` / `demo:reset`, dan TIDAK PERNAH ikut retensi
  /// penghapusan uji coba. Skrip demo MENOLAK tenant yang tidak bertanda ini —
  /// bendera inilah yang memisahkan buku contoh dari buku sungguhan.
  isDemo Boolean @default(false) @map("is_demo")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  companies        Company[]
  users            User[]
  memberships      TenantMembership[]
  deletionRequests TenantDeletionRequest[]
  invitations      Invitation[]
  mailSetting      TenantMailSetting?

  @@index([status])
  @@index([referredByPartner])
  @@map("tenants")
}

/// Keanggotaan TINGKAT TENANT: menjawab "boleh membuat perusahaan? boleh
/// mengubah paket?" — pertanyaan yang harus terjawab TANPA perusahaan aktif,
/// karena pelanggan baru belum punya satu pun. BUKAN pengganti `Membership`
/// (peran per-PT), melainkan lapisan di atasnya.
model TenantMembership {
  id       Int @id @default(autoincrement())
  tenantId Int @map("tenant_id")
  userId   Int @map("user_id")

  /// owner | admin | member (`TENANT_ROLE_VALUES` di src/lib/constants.ts).
  /// BUKAN peran akuntansi — itu milik `memberships`. Minimal SATU owner per
  /// tenant; anti-lockout ditegakkan di lapisan aplikasi (`tenant-directory`).
  role String @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Satu peran tenant per (tenant, pengguna) — sama alasannya dengan
  /// `memberships`: dua peran bukan keadaan yang bisa dijawab penjaga.
  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_memberships")
}

/// Satu PT = satu baris di sini = satu basis data sendiri.
model Company {
  id   Int    @id @default(autoincrement())
  /// Dipakai di URL dan sebagai bagian nama basis data. Huruf kecil, angka, dan
  /// tanda hubung — divalidasi di `lib/validations/company.ts`, bukan hanya di UI.
  ///
  /// UNIK PER TENANT sejak issue #153 (`@@unique([tenantId, slug])` di bawah),
  /// BUKAN se-pemasangan: keunikan global membuat pelanggan saling berebut nama
  /// ("pusat" milik siapa yang duluan) dan galat "sudah dipakai" membocorkan
  /// slug pelanggan lain — kelas kebocoran yang sama dengan §4.4
  /// docs/MULTI-TENANT.md pada username. Nama basis data turunannya ikut aman:
  /// `sai_t{tenantId}_{slug}` memuat id tenant, jadi slug kembar lintas tenant
  /// tidak pernah bertemu di ruang nama fisik.
  slug String @db.VarChar(50)
  name String @db.VarChar(150)

  /// NAMA basis datanya saja, bukan URL lengkap. Host, pengguna, dan kata sandi
  /// diambil dari `DATABASE_URL_TEMPLATE` di environment.
  ///
  /// KENAPA BUKAN URL PENUH: menyimpan URL berarti menyimpan kata sandi basis
  /// data di dalam basis data — satu baris SELECT dan seluruh kredensial setiap
  /// perusahaan ikut terbawa. Nama basis data bukan rahasia; kredensialnya tetap
  /// hanya ada di environment, tempat rahasia memang seharusnya tinggal.
  databaseName String @unique @map("database_name") @db.VarChar(64)

  /// Perusahaan dinonaktifkan, bukan dihapus: bukunya masih ada, kewajiban
  /// pajaknya masih ada, dan riwayatnya masih harus bisa dibuka. `false` =
  /// hilang dari pemilih dan tak bisa dibuka; basis datanya tidak disentuh.
  isActive Boolean @default(true) @map("is_active")

  /// Perusahaan CONTOH — bukunya berisi data buatan, bukan pembukuan sungguhan
  /// (issue #355).
  ///
  /// KENAPA FLAG SENDIRI, bukan menumpang status langganan: read-only yang sudah
  /// ada terikat pada tenant yang DITANGGUHKAN, dan memakainya di sini akan
  /// menampilkan "langganan Anda ditangguhkan" pada perusahaan yang justru
  /// dibuat untuk menyambut pengguna baru. Dua keadaan yang berbeda sama sekali
  /// tidak boleh berbagi satu penanda — persis alasan `/feature-inactive`
  /// dipisahkan dari "tidak punya akses" di issue #99.
  ///
  /// Akibatnya di aplikasi ada DUA: setiap tulisan ditolak penjaga
  /// (`lib/page-auth.ts` / `lib/auth-guard.ts`), dan setiap layarnya membawa
  /// spanduk yang menyebut isinya data contoh. Yang pertama menjaga bukunya,
  /// yang kedua menjaga penggunanya — sebuah buku demo yang bisa dikira nyata
  /// adalah kesalahan yang mahal di aplikasi akuntansi.
  ///
  /// `false` untuk setiap baris yang sudah ada: perusahaan sungguhan tidak
  /// pernah berubah arti karena kolom ini lahir.
  isDemo Boolean @default(false) @map("is_demo")

  /// Tenant PEMILIK perusahaan ini (issue #134). Nullable di TIPE hanya untuk
  /// masa transisi adopsi (migration 0002 → skrip adopsi → 0003 NOT NULL);
  /// kode yang MEMBUAT perusahaan wajib selalu mengisinya — basis data menolak
  /// NULL sejak 0003. `Restrict`: menghapus tenant yang masih punya perusahaan
  /// berarti membuang registry buku yang wajib disimpan — tidak boleh terjadi
  /// lewat cascade yang sunyi.
  tenantId Int?    @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Instans `db-postgres` tempat basis data PT ini hidup (rancangan 09 §9,
  /// tahap 4). `NULL` = instans BAWAAN — template di environment hari ini
  /// (`COMPANY_DATABASE_URL_TEMPLATE`), jadi setiap baris lama tidak berubah
  /// arti. Selain NULL, nilainya WAJIB kunci `db_instances` (FK), dan
  /// penyelesaiannya ada di SATU tempat: `@sai/db/company-url`. Kunci yang tak
  /// dikenali MELEMPAR — jatuh ke bawaan berarti menulis ke salinan lama buku
  /// PT ini di server yang sudah ia tinggalkan.
  ///
  /// FK ke `key`, bukan ke `id`: kunci itulah yang dicerminkan nama env var
  /// dan konfigurasi pohon Go, dan ia tidak berubah seumur instansnya.
  dbInstanceKey String?     @map("db_instance_key") @db.VarChar(32)
  dbInstance    DbInstance? @relation(fields: [dbInstanceKey], references: [key], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships Membership[]
  /// Token API yang boleh membaca buku PT ini (issue #389).
  apiTokens   ApiToken[]
  invitations Invitation[]

  /// Slug unik DI DALAM tenantnya (issue #153) — lihat komentar `slug`.
  /// Dilahirkan bertahap dengan pola #134: migration 0008 menambah indeks ini
  /// BERDAMPINGAN dengan keunikan global lama, `scripts/
  /// prove-company-slug-scope.ts` membuktikan datanya bersih, baru 0009
  /// membuang yang global.
  @@unique([tenantId, slug])
  @@index([isActive])
  @@index([tenantId])
  @@index([isDemo])
  @@index([dbInstanceKey])
  @@map("companies")
}

/// Instans `db-postgres` TAMBAHAN tempat buku PT boleh hidup (rancangan 09 §9,
/// tahap 4). Instans BAWAAN tidak punya baris di sini: ia `companies.
/// db_instance_key = NULL`, dan template-nya tetap env hari ini. Tabel kosong =
/// perilaku persis seperti sebelum tahap 4.
///
/// ══ TIDAK ADA RAHASIA DI SINI ══════════════════════════════════════════════
/// Yang disimpan NAMA env var yang memegang URL template, bukan URL-nya —
/// alasan yang sama dengan `companies.database_name`: satu SELECT tidak boleh
/// membawa pergi kredensial setiap instans.
model DbInstance {
  id  Int    @id @default(autoincrement())
  /// Huruf kecil/angka/garis bawah, diawali huruf; `default` dicadangkan.
  /// Dijaga CHECK di migration 0009 DAN `@sai/db/company-url`.
  key String @unique @db.VarChar(32)

  /// Nama env var berisi URL template instans ini, berbentuk
  /// `COMPANY_<KUNCI>_DATABASE_URL_TEMPLATE`. Bentuknya dipaku supaya baris ini
  /// tidak bisa menunjuk `CONTROL_DATABASE_URL` atau rahasia lain di proses.
  urlEnvVar String @map("url_env_var") @db.VarChar(100)

  /// `false` = tidak dipilih untuk penyediaan PT baru. PT yang SUDAH di sini
  /// tetap dibuka seperti biasa — menonaktifkan instans bukan memutus buku.
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  companies Company[]

  @@index([isActive])
  @@map("db_instances")
}

/// Identitas orang. Satu baris per manusia, berapa pun perusahaan yang dipegangnya.
model User {
  id       Int     @id @default(autoincrement())
  /// Sejak issue #136 BUKAN pengenal login dan BUKAN unik se-pemasangan
  /// (migration 0004 membuang indeks uniknya): Pelanggan B boleh punya `budi`
  /// walau Pelanggan A sudah punya. Tinggal sebagai nama tampilan/panggilan;
  /// keunikan per-TENANT ditegakkan lapisan aplikasi (`users-directory.ts`).
  username String  @db.VarChar(50)
  password String  @db.VarChar(255)
  name     String? @db.VarChar(100)

  /// PENGENAL LOGIN sejak issue #136, unik global — email tidak mengejutkan
  /// siapa pun sebagai pengenal, berbeda dengan username unik se-pemasangan.
  /// Nullable di TIPE hanya untuk masa transisi adopsi (0002 → skrip adopsi
  /// mengisi email dari data yang disiapkan operator → 0003 NOT NULL); kode
  /// yang MEMBUAT pengguna wajib selalu mengisinya.
  email           String?   @unique @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at")

  /// Tenant PEMILIK akun ini. Satu user milik TEPAT SATU tenant — tidak ada
  /// akun yang menyeberang antar-tenant (docs/MULTI-TENANT.md §2). Nullable
  /// hanya untuk masa transisi adopsi, sama seperti `companies.tenant_id`.
  tenantId Int?    @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Wajib mengganti kata sandi sebelum boleh membuka apa pun. Milik IDENTITAS,
  /// bukan keanggotaan: kata sandinya satu untuk semua perusahaan, jadi
  /// kewajiban menggantinya juga satu.
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  passDate           DateTime? @map("pass_date")

  /// Pencabutan sesi (audit RBAC fase 3). JWT menyimpan angka ini saat login;
  /// revalidasi berkala membandingkannya dengan DB — beda = sesi mati. Tetap di
  /// tingkat PENGGUNA: mencabut sesi berarti mencabutnya di semua perusahaan,
  /// yang memang perilaku yang benar saat kata sandi di-reset.
  sessionVersion Int @default(1) @map("session_version")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships         Membership[]
  tenantMemberships   TenantMembership[]
  /// Token API yang ia terbitkan (issue #389).
  apiTokensCreated    ApiToken[]
  passwordResetTokens PasswordResetToken[]
  /// Pemberitahuan dalam aplikasi yang ditujukan kepadanya.
  notifications       Notification[]

  @@index([tenantId])
  @@index([tenantId, username])
  @@map("users")
}

/// Token atur-ulang kata sandi (issue #136) — disimpan TER-HASH (SHA-256),
/// berbatas waktu, sekali pakai. Token mentah hanya pernah hidup di dalam
/// surel yang dikirim ke pemiliknya; baris di sini tidak cukup untuk mengatur
/// ulang apa pun tanpa surel itu.
model PasswordResetToken {
  id     Int @id @default(autoincrement())
  userId Int @map("user_id")

  /// SHA-256 hex dari token mentah. Unik: satu token satu baris.
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  /// Terisi = sudah dipakai; token yang sama tidak pernah bekerja dua kali.
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Undangan staf lewat email (issue #139) — pengganti alur "admin mengetik
/// kata sandi orang lain": penerima menentukan kata sandinya SENDIRI lewat
/// tautan berbatas waktu. Baris di sini hanya untuk calon PENGGUNA BARU;
/// orang yang sudah punya akun setenant langsung ditambahkan keanggotaannya
/// (`addExistingUserToCompany`) tanpa baris undangan.
///
/// Token disimpan TER-HASH (SHA-256), berbatas waktu, sekali pakai — pola yang
/// sama persis dengan `password_reset_tokens`.
model Invitation {
  id Int @id @default(autoincrement())

  /// Tenant & PT tujuan. Disimpan dua-duanya walau company sudah menyiratkan
  /// tenant: kuota `max_users` dihitung per TENANT, dan penerimaan harus
  /// membuktikan keduanya masih serasi tanpa join tambahan.
  tenantId  Int     @map("tenant_id")
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId Int     @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Alamat yang diundang, huruf kecil. TIDAK unik: undangan lama yang hangus
  /// boleh berdampingan dengan yang baru — hanya yang termuda yang hidup
  /// (yang lama ditandai `used_at` saat yang baru terbit).
  email String @db.VarChar(255)

  /// Peran DI PT TUJUAN (nilai `roles.key` basis data perusahaan itu) — BUKAN
  /// peran tenant; penerima undangan selalu lahir sebagai tenant `member`.
  companyRole String @map("company_role") @db.VarChar(20)

  /// Pengundang — id pengguna global, untuk jejak. FK sengaja TIDAK dipasang:
  /// undangan harus tetap terbaca walau akun pengundangnya kelak dihapus.
  invitedByUserId Int @map("invited_by_user_id")

  /// SHA-256 hex dari token mentah; token mentah hanya hidup di dalam surel.
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  /// Terisi = sudah dipakai ATAU digantikan undangan yang lebih baru/dicabut.
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([companyId])
  @@index([email])
  @@index([expiresAt])
  @@index([invitedByUserId])
  @@map("invitations")
}

/// Pengguna × perusahaan × peran. Inilah yang tidak bisa dinyatakan oleh satu
/// kolom `users.role`: seseorang bisa Direktur Utama di PT A dan Kepala Gudang
/// di PT B, dan kedua kenyataan itu harus hidup berdampingan.
/// PENDAFTARAN MANDIRI yang belum terverifikasi (issue #138) — keadaan
/// "pending_verification" dari perjalanan §7.1 hidup DI SINI, bukan sebagai
/// baris `tenants`: Tenant + User(owner) + TenantMembership baru lahir — dalam
/// SATU transaksi — ketika tautan verifikasi diklik. Sebelum itu tidak ada
/// apa pun yang menempati email unik, tidak ada basis data yang dibuat, dan
/// pendaftaran yang ditinggalkan kedaluwarsa tanpa menyisakan akun setengah
/// jadi yang harus dibersihkan.
model Registration {
  id Int @id @default(autoincrement())

  /// BUKAN unik: orang boleh meminta ulang surel verifikasinya; token termuda
  /// yang menang (yang lama ditandai terpakai oleh permintaan baru).
  email String @db.VarChar(255)
  /// Nama ORANG yang mendaftar — menjadi `users.name`.
  name  String @db.VarChar(100)

  /// Nama AKUN (usaha/kantor) — menjadi `tenants.name` dan dasar slug tenant
  /// (issue #458). NULL hanya untuk baris yang dibuat sebelum kolom ini ada;
  /// jalur verifikasi menanganinya dengan jatuh ke perilaku lama.
  accountName String? @map("account_name") @db.VarChar(150)

  /// bcrypt — kata sandi diketik sekali saat mendaftar dan langsung di-hash;
  /// nilai mentahnya tidak pernah disimpan di mana pun.
  passwordHash String @map("password_hash") @db.VarChar(255)

  /// SHA-256 hex token verifikasi (pola `password_reset_tokens`): token mentah
  /// hanya hidup di dalam surel.
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  /// Terisi = sudah diverifikasi ATAU digantikan permintaan yang lebih baru.
  usedAt    DateTime? @map("used_at")

  /// Jejak persetujuan S&K — kapan kotaknya dicentang (dikirim bersama form).
  termsAcceptedAt DateTime @map("terms_accepted_at")

  /// VERSI dokumen yang disetujui (issue #142) — "menyetujui S&K" tanpa versi
  /// tidak membuktikan apa-apa begitu dokumennya berubah. Nullable hanya untuk
  /// baris yang lahir sebelum kolomnya ada; alur daftar selalu mengisinya
  /// (nilai dari `lib/legal.ts`).
  termsVersion   String? @map("terms_version") @db.VarChar(30)
  privacyVersion String? @map("privacy_version") @db.VarChar(30)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([expiresAt])
  @@map("registrations")
}

/// PERMINTAAN PENGHAPUSAN AKUN (issue #142, UU PDP) — penghapusan TIDAK PERNAH
/// terjadi dari satu tombol: baris ini hanyalah PERMINTAAN eksplisit, dengan
/// masa tenggang untuk berubah pikiran, dan EKSEKUSINYA di tangan operator
/// lewat skrip bergerbang bukti (scripts/execute-tenant-deletion.ts — pola
/// adopsi #134). Buku besar TIDAK dihapus oleh eksekusi: UU KUP menuntut
/// retensi 10 tahun; yang terjadi adalah penonaktifan + anonimisasi data
/// pribadi, dan penghancuran buku baru boleh SETELAH `retention_until`
/// (docs/COMPLIANCE.md).
model TenantDeletionRequest {
  id       Int @id @default(autoincrement())
  tenantId Int @map("tenant_id")

  /// Id pengguna GLOBAL peminta — sengaja TANPA FK (pola periods.closed_by_id):
  /// eksekusi menganonimkan pengguna, dan permintaan harus tetap terbaca
  /// sebagai jejak sesudahnya.
  requestedByUserId Int @map("requested_by_user_id")

  /// pending | cancelled | executed (`DELETION_REQUEST_STATUSES`,
  /// lib/tenant-deletion.ts).
  status String @default("pending") @db.VarChar(20)

  /// Akhir masa tenggang — sebelum ini lewat, eksekusi DITOLAK skripnya.
  graceEndsAt DateTime  @map("grace_ends_at")
  cancelledAt DateTime? @map("cancelled_at")
  executedAt  DateTime? @map("executed_at")

  /// Batas retensi UU KUP, dihitung SAAT eksekusi dari tanggal jurnal termuda
  /// + 10 tahun. Sebelum lewat, penghancuran buku (--drop-ledgers) ditolak.
  retentionUntil DateTime? @map("retention_until")

  /// Alasan dari peminta (opsional) — membantu operator menimbang.
  note String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([requestedByUserId])
  @@map("tenant_deletion_requests")
}

/// Penghitung pembatas laju PERSISTEN (issue #138) — `lib/rate-limit.ts` yang
/// lama menghitung di `Map` memori: hilang saat proses dimulai ulang dan tidak
/// terbagi antar-instance. Untuk /login internal itu diterima; untuk endpoint
/// yang TERBUKA KE INTERNET (/register, atur-ulang kata sandi) tidak. Baris =
/// satu kunci (mis. `register:ip:1.2.3.4`) dengan jendela tetap; penambahannya
/// atomik lewat `INSERT … ON DUPLICATE KEY UPDATE` (lib/rate-limit-persistent.ts).
model RateLimitCounter {
  id Int @id @default(autoincrement())

  key             String   @unique @db.VarChar(160)
  windowStartedAt DateTime @map("window_started_at")
  count           Int      @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([updatedAt])
  @@map("rate_limit_counters")
}

model Membership {
  id        Int @id @default(autoincrement())
  userId    Int @map("user_id")
  companyId Int @map("company_id")

  /// Peran DI PERUSAHAAN INI. Nilainya sama dengan `users.role` yang lama
  /// (managing_director | finance_manager | warehouse_head | administrator, plus
  /// peran kustom) — tapi peran kustom adalah DATA di basis data perusahaan
  /// (tabel `roles`), jadi nilai di sini hanya sah untuk perusahaan itu.
  role String @db.VarChar(20)

  /// Preferensi tampilan "Mode Akuntan" (issue #11). NULL = ikut bawaan peran.
  /// Milik KEANGGOTAAN, bukan pengguna: bawaannya diturunkan dari peran, dan
  /// peran berbeda per perusahaan — orang yang sama bisa butuh permukaan
  /// akuntansi di PT A dan tidak di PT B.
  accountantMode Boolean? @map("accountant_mode")

  /// Dicabut aksesnya ke perusahaan ini tanpa menghapus jejak bahwa ia pernah
  /// punya. Menghapus baris juga sah untuk keanggotaan yang salah buat.
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Satu peran per (pengguna, perusahaan). Dua peran di satu perusahaan bukan
  /// keadaan yang bisa dijawab penjaga izin tanpa menebak.
  @@unique([userId, companyId])
  @@index([companyId])
  @@index([isActive])
  @@map("memberships")
}

// ─── Token API (issue #389 — F-10 lapis 1) ───────────────
/// Kredensial mesin untuk membaca buku SATU perusahaan lewat `/api/v1/…`.
///
/// ══ KENAPA DI BASIS DATA KENDALI ═══════════════════════════════════════════
/// Ia menjawab pertanyaan yang sama dengan `memberships`: "siapa boleh membuka
/// buku mana, sebagai apa". Pertanyaan itu selalu dijawab kendali — buku
/// perusahaan tidak boleh memuat kredensial yang bisa membuka dirinya sendiri,
/// sebab satu SELECT di sana akan membawa pergi kuncinya.
///
/// ══ TOKENNYA TIDAK PERNAH DISIMPAN ═════════════════════════════════════════
/// Yang tersimpan SHA-256-nya. Bentuk tokennya `sai_<id>_<rahasia>`: `id`
/// dipakai MENCARI barisnya (satu kueri berindeks, bukan memindai seluruh
/// tabel dan membandingkan hash satu per satu), `rahasia` yang di-hash.
///
/// SHA-256, BUKAN bcrypt — dan itu bukan kelalaian. bcrypt sengaja lambat untuk
/// menahan penebakan kata sandi manusia yang entropinya rendah; rahasia di sini
/// 32 byte acak, dan menebaknya mustahil tanpa bantuan pelambatan apa pun.
/// Memakai bcrypt di sini berarti membayar ~100 ms pada SETIAP permintaan API
/// untuk keamanan yang tidak bertambah.
model ApiToken {
  id        Int @id @default(autoincrement())
  companyId Int @map("company_id")

  /// Nama yang ditulis manusia ("Integrasi kasir", "Laporan mingguan") — supaya
  /// mencabut token berarti mencabut sesuatu yang bisa dikenali, bukan sebuah id.
  name String @db.VarChar(100)

  /// SHA-256 heksadesimal dari bagian rahasianya. 64 karakter, selalu.
  tokenHash String @map("token_hash") @db.VarChar(64)

  /// Peran yang DIPERANKAN token ini di perusahaan itu.
  ///
  /// Bukan daftar cakupan tersendiri, dan itu keputusan: matriks izin sudah
  /// menjawab "peran apa boleh apa", termasuk override per perusahaan
  /// (issue #73). Daftar cakupan kedua di sebelahnya akan menyimpang dari
  /// matriks itu pada perubahan izin pertama — dan yang menyimpang selalu yang
  /// lebih jarang dibaca.
  role String @db.VarChar(20)

  /// Siapa yang menerbitkannya. Id global (basis data ini), jadi FK-nya sah.
  createdByUserId Int @map("created_by_user_id")

  /// Kapan terakhir dipakai — satu-satunya cara pemiliknya tahu token mana yang
  /// sudah tidak dipakai siapa pun dan aman dicabut. Ditulis paling banyak
  /// sekali per menit; lihat `lib/api-token.ts`.
  lastUsedAt DateTime? @map("last_used_at")

  /// Dicabut. Baris TIDAK dihapus: token yang pernah menarik data pelanggan
  /// harus tetap bisa dijawab "siapa yang menerbitkannya, dan kapan dicabut".
  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([revokedAt])
  @@index([createdByUserId])
  @@map("api_tokens")
}

/// Pemberitahuan DALAM APLIKASI untuk satu pengguna.
///
/// ══ KENAPA ADA ═════════════════════════════════════════════════════════════
/// Empat perusahaan mandek di wisaya penyiapan selama enam hari (issue #416) dan
/// tidak ada satu pun kanal yang memberi tahu siapa pun — tidak pemiliknya,
/// tidak operatornya. Bahkan setelah diperbaiki, satu-satunya cara mengabari
/// mereka adalah surel yang dikirim tangan.
///
/// ══ KENAPA DI BASIS DATA KENDALI ═══════════════════════════════════════════
/// Pemberitahuan milik PENGGUNA, dan pengguna hidup di kendali sejak #104.
/// Menaruhnya di buku perusahaan berarti orang yang punya dua PT punya dua
/// kotak masuk yang tak pernah bertemu — dan pemberitahuan yang paling penting
/// (penyiapan belum selesai) justru lahir SEBELUM ada buku yang bisa dibaca.
///
/// ══ IDEMPOTEN LEWAT `dedupe_key` ═══════════════════════════════════════════
/// `@@unique([userId, kind, dedupeKey])` — doktrin yang sama dengan
/// `ReminderLog` (#140): produser yang berjalan dua kali MENABRAK constraint,
/// bukan melahirkan pemberitahuan kembar. Penjadwal yang jalan tiap jam karena
/// itu aman memanggilnya tiap jam.
model Notification {
  id Int @id @default(autoincrement())

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// enum-like: setup_incomplete | … — `String @db.VarChar` + z.enum,
  /// konvensi docs/DATABASE.md. Menentukan ikon & pengelompokan, bukan izin.
  kind String @db.VarChar(40)

  title String @db.VarChar(150)
  body  String @db.VarChar(1000)

  /// Tautan DALAM aplikasi (mis. `/t/acme/pt-a/setup`). NULL = tidak menuju
  /// ke mana pun — pemberitahuan yang hanya memberi kabar.
  href String? @db.VarChar(255)

  /// Kunci idempotensi milik produser. Lihat catatan di kepala model.
  dedupeKey String @map("dedupe_key") @db.VarChar(120)

  /// NULL = belum dibaca. Waktu, bukan boolean: "kapan dibaca" adalah
  /// pertanyaan yang selalu muncul berikutnya, dan boolean tidak bisa
  /// menjawabnya tanpa migration kedua.
  readAt DateTime? @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, kind, dedupeKey])
  @@index([userId, readAt])
  @@map("notifications")
}

/// Slug tenant yang PERNAH dipakai (#458).
///
/// Alamat lama tetap hidup di bookmark, di surel undangan yang sudah terkirim,
/// dan di tautan yang dibagikan ke akuntan eksternal. Baris di sini yang
/// membuatnya tetap sampai: jalur masuk mencarinya lalu memantulkan permanen
/// ke alamat kanonik.
///
/// `slug` UNIK dan tidak pernah dilepas: slug lama yang bisa diambil akun lain
/// berarti tautan lama yang mendarat di buku MILIK ORANG LAIN.
model TenantSlugHistory {
  id       Int    @id @default(autoincrement())
  tenantId Int    @map("tenant_id")
  slug     String @unique @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("tenant_slug_history")
}

/// SERVER SUREL MILIK TENANT SENDIRI.
///
/// ══ KENAPA DI BASIS DATA KENDALI, BUKAN PLATFORM ════════════════════════════
/// `mail_settings` di `sai_platform` adalah milik PENYEDIA: satu untuk seluruh
/// pemasangan, dipakai surel yang datang DARI KAMI (undangan staf, atur-ulang
/// kata sandi, verifikasi pendaftaran). Tabel ini menjawab pertanyaan yang
/// berbeda: dari server siapa surel yang dikirim ATAS NAMA PELANGGAN keluar —
/// faktur dan pengingat jatuh tempo kepada pelanggannya sendiri.
///
/// Rumahnya basis data KENDALI karena dua alasan yang saling menguatkan:
/// tenant hidup di sini, dan doktrin #137 menyatakan platform yang mati tidak
/// boleh mematikan surel. Menaruhnya di platform berarti penagihan yang mati
/// ikut mematikan penagihan PELANGGAN kita — kegagalan yang menular ke arah
/// yang paling tidak masuk akal.
///
/// ══ KENAPA PER TENANT, BUKAN PER PT ════════════════════════════════════════
/// Satu kotak surel per badan usaha adalah beban administrasi yang nyata, dan
/// tenant dengan tiga PT hampir selalu menagih dari satu alamat. Yang
/// membedakan surat antar-PT adalah ISINYA — nama perusahaan di badan surel
/// dan di kertas fakturnya berasal dari `company_settings`, bukan dari alamat
/// pengirimnya.
///
/// ══ YANG TIDAK PERNAH LEWAT SINI ═══════════════════════════════════════════
/// Surel yang membawa TOKEN AKSES: atur-ulang kata sandi, undangan, verifikasi
/// pendaftaran, permintaan penghapusan tenant. Ketiganya tetap lewat pengaturan
/// PENYEDIA, dan itu bukan kelalaian melainkan pagar: tautan yang membuka akun
/// di aplikasi kami tidak boleh berangkat dari server surel yang dikendalikan
/// pelanggan, dan pelanggan juga tidak boleh dibebani kegagalan pengiriman
/// untuk surel yang bukan urusannya.
model TenantMailSetting {
  id       Int @id @default(autoincrement())
  tenantId Int @unique @map("tenant_id")

  /// file | smtp. `file` = ditangkap ke berkas .eml (mode aman, bawaan).
  transport String @default("file") @db.VarChar(10)

  host     String? @db.VarChar(191)
  port     Int?
  username String? @db.VarChar(191)

  /// Alamat pengirim, mis. "PT Contoh <tagihan@contoh.co.id>". Kosong = pakai
  /// alamat pengirim milik penyedia.
  fromAddress String? @map("from_address") @db.VarChar(191)

  /// Segel AES-256-GCM kata sandi SMTP (`lib/settings-crypto.ts`). Ketiganya
  /// kosong = tanpa kata sandi (relai yang mengautentikasi lewat IP juga sah).
  /// Kata sandi mentah TIDAK PERNAH keluar lewat pembacaan mana pun.
  passwordCiphertext String? @map("password_ciphertext") @db.VarChar(512)
  passwordIv         String? @map("password_iv") @db.VarChar(64)
  passwordTag        String? @map("password_tag") @db.VarChar(64)

  /// Salinan SENYAP (BCC) surel keluar milik tenant ini. BCC, bukan CC —
  /// alasan yang sama dengan `MailSetting.archive_address`: CC memperlihatkan
  /// alamat ini kepada setiap pelanggan yang menerima surelnya.
  archiveAddress String? @map("archive_address") @db.VarChar(191)

  /// Hasil UJI KIRIM terakhir. Konfigurasi surel yang tidak pernah diuji adalah
  /// konfigurasi yang baru ketahuan salah pada faktur pertama yang gagal
  /// terkirim — dan yang menanggungnya pelanggan kita, bukan kita.
  lastTestAt      DateTime? @map("last_test_at")
  lastTestTo      String?   @map("last_test_to") @db.VarChar(191)
  /// ok | error
  lastTestStatus  String?   @map("last_test_status") @db.VarChar(10)
  lastTestMessage String?   @map("last_test_message") @db.Text

  /// Siapa yang terakhir menyimpannya — id pengguna global, sebagai teks.
  updatedBy String @map("updated_by") @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_mail_settings")
}

/// Jejak audit tingkat TENANT (issue #484) — pendaftaran, ganti slug, permintaan
/// penghapusan, ekspor, undangan, dan tindakan operator.
///
/// ══ KENAPA DI BASIS DATA KENDALI ═══════════════════════════════════════════
/// Karena yang dicatatnya adalah peristiwa TENANT, bukan peristiwa sebuah PT.
/// Sampai #484 ia `appendFile` ke `data/audit/tenants/<slug>/audit.jsonl`:
/// dibaca utuh setiap kali, tidak ter-paginasi, tidak ikut cadangan, dan tidak
/// ikut ke mana pun.
///
/// ══ TANPA FOREIGN KEY KE `tenants`, DAN ITU INTI SELURUH ISU ═══════════════
/// Jejak inilah yang mencatat PENGHAPUSAN sebuah tenant. Menaruhnya di tempat
/// yang ikut mati bersama yang dicatatnya membuat catatan itu tidak ada
/// artinya — `ON DELETE CASCADE` di sini akan menghapus justru baris yang
/// paling perlu dibaca sesudahnya.
///
/// Perhatikan bahwa ini KEBALIKAN dari #370, di mana "mati bersama bukunya"
/// justru salah satu kriteria selesainya. Bedanya bukan selera: jejak PT adalah
/// bagian dari buku PT itu, sedangkan jejak tenant adalah catatan TENTANG
/// tenant — termasuk tentang akhirnya.
///
/// Karena itu `tenantId` hanyalah angka, dan `tenantSlug` DISALIN: sesudah
/// tenant-nya tiada, slug itu satu-satunya yang membuat barisnya masih bisa
/// dibaca manusia. Pola yang sama dengan `AuditLog.userId` + `username` di
/// basis data perusahaan.
model TenantAuditLog {
  id Int @id @default(autoincrement())

  /// Id entri di berkas JSONL lama (`<epoch>-<acak>`), diisi HANYA oleh
  /// `bun run migrate:tenant-audit`. Inilah yang membuat pemindahan idempoten
  /// lewat CONSTRAINT alih-alih periksa-lalu-tulis — doktrin yang sama dengan
  /// `AuditLog.legacyId`. Baris yang lahir dari aplikasi mengisinya NULL, dan
  /// MySQL mengizinkan NULL berulang pada kolom unik.
  legacyId String? @unique @map("legacy_id") @db.VarChar(40)

  /// Angka, BUKAN relasi — lihat catatan di atas.
  tenantId   Int    @map("tenant_id")
  /// Disalin supaya barisnya tetap terbaca sesudah tenant-nya tiada.
  tenantSlug String @map("tenant_slug") @db.VarChar(63)

  /// Id GLOBAL pengguna, sebagai teks; `"system"` untuk yang tanpa aktor.
  userId     String  @map("user_id") @db.VarChar(64)
  username   String  @db.VarChar(100)
  /// Peran tenant aktor SAAT beraksi. Peran bisa berubah; jejak tidak.
  tenantRole String? @map("tenant_role") @db.VarChar(50)

  /// enum-like `TenantAuditAction` di `lib/tenant-audit.ts`.
  action String @db.VarChar(50)

  /// Rincian sebagai JSON dalam TEKS — alasan yang sama dengan
  /// `AuditLog.details`: skema ini belum punya satu pun kolom `Json`.
  details String? @db.Text

  /// Entri ke-N dari KANAN pada rantai proksi (issue #372). Jejak yang mencatat
  /// alamat pilihan penyerang menyesatkan penyelidikan yang membacanya.
  ipAddress String? @map("ip_address") @db.VarChar(45)

  createdAt DateTime @default(now()) @map("created_at")

  /// Pembacaan selalu "jejak SATU tenant, terbaru dulu" — index gabungan,
  /// bukan dua index terpisah.
  @@index([tenantSlug, createdAt])
  @@index([tenantId])
  @@index([userId])
  /// Bacaan LINTAS tenant di `/operator/audit/tenants` (migration 0003).
  @@index([createdAt])
  @@index([action])
  @@map("tenant_audit_logs")
}

/// AKUN OPERATOR (migration kendali 0004) — akun konsol penyedia yang
/// dikelola dari layar, berperan bertingkat, dan sesinya bisa dicabut.
///
/// ══ KENAPA DI BASIS DATA KENDALI, BUKAN `sai_platform` ═════════════════════
/// Penjaga konsol (`lib/operator/guard.ts`) membaca tabel ini pada SETIAP
/// permintaan, dan doktrin #137 melarang penjaga bergantung pada basis data
/// penagihan: penagihan yang mati tidak boleh mematikan gerbangnya. Kendali
/// memang sudah syarat hidup konsol (daftar tenant tinggal di sana).
///
/// ══ AKUN ENV TETAP ADA ═════════════════════════════════════════════════════
/// `OPERATOR_USERS` tetap berlaku sebagai akun DARURAT berperan `owner`, tanpa
/// basis data sama sekali — supaya kendali yang mati atau baris yang salah
/// ubah tidak pernah mengunci semua orang keluar. Nama yang sudah dipakai akun
/// env ditolak di sini.
///
/// Rahasia TOTP DIENKRIPSI (AES-256-GCM, `SETTINGS_ENCRYPTION_KEY`, pola
/// `mail_settings`): bocornya cadangan basis data tidak boleh sekaligus
/// membocorkan faktor kedua. Tanpa kunci itu akun basis data tidak bisa dibuat
/// MAUPUN dipakai masuk (gagal-tertutup).
///
/// Bukan tabel `users`: operator bukan pelanggan (#154).
model OperatorAccount {
  id Int @id @default(autoincrement())

  /// Pengenal untuk jejak audit — pola `NAME_PATTERN` di `credentials.ts`.
  name String @unique @db.VarChar(50)

  /// owner | billing | support | viewer — `OPERATOR_ROLES` di `lib/operator/roles.ts`.
  role String @db.VarChar(20)

  /// bcrypt.
  passwordHash String @map("password_hash") @db.VarChar(100)

  /// Rahasia TOTP base32, tersegel (`settings-crypto.ts`).
  totpCiphertext String @map("totp_ciphertext") @db.Text
  totpIv         String @map("totp_iv") @db.VarChar(32)
  totpTag        String @map("totp_tag") @db.VarChar(32)

  isActive Boolean @default(true) @map("is_active")

  /// Dinaikkan untuk MENCABUT semua sesi akun ini. Token membawa versinya;
  /// penjaga menolak token yang versinya tidak sama.
  sessionVersion Int @default(1) @map("session_version")

  lastLoginAt DateTime? @map("last_login_at")

  /// Nama operator yang membuat akun ini — jejak lengkapnya di jejak operator.
  createdBy String @map("created_by") @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("operator_accounts")
}

/// ═══════════════════════════════════════════════════════════════════════════
/// JEJAK PUTARAN — penjadwal, kesesuaian data, cadangan
///
/// ══ KENAPA DI KENDALI, BUKAN `sai_platform` ════════════════════════════════
/// Ketiga tabel ini dulu tinggal di platform karena layar pembacanya konsol
/// operator. Itu keliru, dan keliru dengan cara yang baru terlihat pada profil
/// on-premise: `sai_platform` TIDAK DIPASANG di sana, sementara penjadwal,
/// pemeriksa kesesuaian, dan cadangan tetap BERJALAN. Akibatnya `/api/health`
/// tidak bisa menjawab "apakah cadangan semalam berhasil" — tepat pada
/// pemasangan yang customer-nya sendiri memegang cadangan itu, dan tepat pada
/// pertanyaan yang paling mahal untuk tidak terjawab.
///
/// Garis doktrin #137 bukan "siapa yang melihat layarnya", melainkan **apakah
/// penagihan yang mati boleh mematikannya**. Jejak putaran menggambarkan
/// operasi yang terjadi di KEDUA profil; penagihan tidak. Alasan yang sama
/// menempatkan `OperatorAccount` di sini.
///
/// Dua akibat lain yang ikut benar: tabel `jobs` (rancangan §4) akan tinggal di
/// kendali juga, jadi "pekerjaan" dan "jejak pekerjaan" berada di satu basis
/// data yang sama dan ikut satu cadangan yang sama — dan `prune-run-trails`
/// tidak lagi menuntut basis data penagihan hidup untuk memangkas jejak.
///
/// ⚠ Ketiganya TANPA relasi ke model lain, dan itu disengaja: jejak putaran
/// adalah catatan operasional yang harus tetap bisa dibaca ketika yang
/// dirujuknya sudah dihapus.
/// ═══════════════════════════════════════════════════════════════════════════

/// Satu baris per putaran penjadwal (#140).
model SchedulerRun {
  id Int @id @default(autoincrement())

  startedAt  DateTime @map("started_at")
  finishedAt DateTime @map("finished_at")

  /// ok | error — `error` = ada butir yang menuntut tindakan orang
  /// (rinciannya di `details.errors`). String + union TS, konvensi
  /// docs/DATABASE.md.
  status String @db.VarChar(10)

  invoicesIssued Int @default(0) @map("invoices_issued")
  remindersSent  Int @default(0) @map("reminders_sent")
  statusChanges  Int @default(0) @map("status_changes")
  adoptions      Int @default(0)
  errorCount     Int @default(0) @map("error_count")

  /// JSON `{issued, reminders, transitions, adoptions, errors}` — masing-masing
  /// daftar string BARIS LAPORAN (bukan struktur yang di-query), persis kalimat
  /// yang dulu hanya tercetak di stdout. Dibiarkan Text: isi lama tidak perlu
  /// bermigrasi saat bentuk barisnya berubah.
  details String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([startedAt])
  @@map("scheduler_runs")
}

/// Satu baris per sapuan kesesuaian data (#374).
model ConformanceRun {
  id Int @id @default(autoincrement())

  startedAt  DateTime @map("started_at")
  finishedAt DateTime @map("finished_at")

  /// ok | findings | error — TIGA nilai, dan bedanya menentukan:
  /// `ok` = berjalan & bersih; `findings` = berjalan & menemukan sesuatu (bukan
  /// kegagalan layanan); `error` = ada buku yang GAGAL diperiksa, dan buku yang
  /// tidak terperiksa bukan buku yang bersih. Konvensi String + union TS.
  status String @db.VarChar(12)

  /// Berapa buku disapu, dan berapa yang gagal diperiksa. Yang pertama membuat
  /// "apakah sapuannya melewatkan buku baru?" bisa dijawab tanpa menebak.
  companiesChecked Int @default(0) @map("companies_checked")
  companiesFailed  Int @default(0) @map("companies_failed")

  /// Total baris temuan di seluruh buku. Nol = bersih.
  findingCount Int @default(0) @map("finding_count")

  /// JSON `{findings, failures}` — daftar baris laporan, persis kalimat yang
  /// dulu hanya tercetak ke stdout. Text: isi lama tidak perlu bermigrasi saat
  /// bentuk barisnya berubah (alasan yang sama dengan `SchedulerRun.details`).
  ///
  /// Memuat LABEL temuan, bukan nilai uang dan bukan baris datanya.
  details String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([finishedAt])
  @@index([status, finishedAt])
  @@map("conformance_runs")
}

/// Satu baris per putaran fan-out migration BUKU (`db:migrate:companies`,
/// 09 §6). Kebenaran skema satu buku tetap `_prisma_migrations` buku itu;
/// baris ini mencatat apa yang dicoba putaran dan jawabannya — dibaca
/// `/api/health` (`migrations`) dan orang yang melanjutkan rilis dari tengah.
model SchemaMigrationRun {
  id Int @id @default(autoincrement())

  startedAt  DateTime @map("started_at")
  finishedAt DateTime @map("finished_at")

  /// ok | partial | error — `partial` = sebagian buku gagal, sisanya di
  /// kepala (rilis boleh lanjut, buku yang gagal ditutup gerbang skema);
  /// `error` = tidak satu buku pun berhasil. Konvensi String + union TS.
  status String @db.VarChar(12)

  /// Migration buku terakhir yang dibawa image penerapnya
  /// (`MIGRATION_TERAKHIR.company`). Membandingkannya dengan image yang
  /// melayani menjawab "fan-out untuk rilis INI sudah berjalan?".
  targetMigration String @map("target_migration") @db.VarChar(191)

  companiesTotal    Int @default(0) @map("companies_total")
  /// Buku yang `migrate deploy`-nya dijalankan putaran ini dan berhasil.
  companiesMigrated Int @default(0) @map("companies_migrated")
  /// Buku yang SUDAH di kepala sebelum putaran — dilewati tanpa proses Prisma.
  companiesSkipped  Int @default(0) @map("companies_skipped")
  companiesFailed   Int @default(0) @map("companies_failed")

  /// JSON `{companies: [{slug, instance, outcome, before, after, ms, error}]}`.
  /// Text, bukan Json: bentuk barisnya boleh berubah tanpa migration.
  details String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([finishedAt])
  @@map("schema_migration_runs")
}

/// Satu baris per putaran cadangan (#374).
model BackupRun {
  id Int @id @default(autoincrement())

  startedAt  DateTime @map("started_at")
  finishedAt DateTime @map("finished_at")

  /// ok | local | error — konvensi String + union TS, lihat docs/DATABASE.md.
  ///
  /// `local` (12 Okt 2026): artefak terenkripsi DIBUAT tapi tetap di mesin ini,
  /// sebab `BACKUP_S3_BUCKET` belum disetel. Sengaja BUKAN `ok` — `backupHealth`
  /// mencari keberhasilan dengan `where: { status: "ok" }`, jadi nilai terpisah
  /// inilah yang mencegah salinan lokal mengisi `lastSuccessAt`.
  status String @db.VarChar(10)

  /// Sebab kegagalan, apa adanya dari `backup.sh`. Null saat berhasil.
  ///
  /// TIDAK memuat kredensial: yang ditulis skripnya adalah kalimat sebab
  /// ("BACKUP_ENCRYPTION_KEY belum diset"), bukan nilainya.
  error String? @db.Text

  /// Nama objek yang dikirim, saat berhasil. Bukti yang bisa dicari kembali.
  artifact String? @db.VarChar(255)

  /// Ukuran terkirim dalam byte. Cadangan yang "berhasil" tapi 0 byte adalah
  /// kegagalan yang paling meyakinkan bentuknya.
  sizeBytes BigInt? @map("size_bytes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([finishedAt])
  @@index([status, finishedAt])
  @@map("backup_runs")
}

/// ═══════════════════════════════════════════════════════════════════════════
/// ANTREAN PEKERJAAN (rancangan §4) — satu baris = satu pekerjaan
///
/// ══ KENAPA DI KENDALI, BUKAN BASIS DATA BARU ═══════════════════════════════
/// Aplikasi sudah punya koneksi ke sini (2 dianggarkan), dan `tenant_id` serta
/// `company_id` yang dirujuk baris ini juga hidup di sini. Basis data ke-20
/// berarti satu pasangan pool, satu entri migration, dan satu objek dump lagi
/// demi nol manfaat. `sai_platform` gugur karena doktrin #137 melarangnya dari
/// jalur panas — dan membaca kemajuan pekerjaan ADALAH jalur panas.
///
/// ⚠ Harganya nyata: kendali juga melayani AUTENTIKASI, dan antrean
/// ber-`SKIP LOCKED` membuat baris mati lebih cepat daripada tabel lain di
/// sini. Pemicu memindahkannya ke basis datanya sendiri: latensi p95 kueri
/// autentikasi naik TERUKUR seiring throughput antrean. Sebelum itu terukur,
/// memisahkannya adalah ongkos tanpa manfaat.
///
/// ══ KENAPA POSTGRES, BUKAN BROKER ══════════════════════════════════════════
/// Broker terpisah mengembalikan masalah yang sudah selesai: commit berhasil,
/// publish gagal, dan tidak ada yang tahu apakah mengulang memperbaiki atau
/// menduplikasi. Untuk buku besar itu kelas kegagalan yang tidak boleh ada.
///
/// ══ TANPA LEADER ELECTION ══════════════════════════════════════════════════
/// Penerbitan idempoten lewat `dedupeKey` UNIK: denyut yang berjalan dua kali
/// menabrak constraint sebelum apa pun terjadi. Itu lebih sederhana DAN lebih
/// kuat daripada pemilihan pemimpin, yang punya mode gagalnya sendiri.
///
/// Indeks yang menentukan ditulis TANGAN di migration kendali 0006 — Prisma
/// tidak bisa menyatakan *partial index*, dan tanpa predikat `status =
/// 'queued'` pengambilan melambat seiring antrean tumbuh.
/// ═══════════════════════════════════════════════════════════════════════════
model Job {
  id Int @id @default(autoincrement())

  /// `report.export`, `tenant.backup`, … — kosakatanya di `contract/kinds.yaml`,
  /// dan tipenya dibangkitkan (`@sai/core/generated/job-kinds`). TIDAK ada CHECK
  /// di DB: kosakatanya berubah lewat kontrak, dan constraint yang harus ikut
  /// setiap penambahan `kind` adalah migration yang pasti terlupakan.
  kind String @db.VarChar(40)

  /// Keduanya BOLEH null, dan artinya bertingkat:
  /// `tenantId` null = pekerjaan tingkat PEMASANGAN (mis. `schedule.tick`);
  /// `companyId` null = pekerjaan tingkat TENANT (mis. ekspor seluruh tenant).
  /// Bukan FK: pekerjaan harus tetap terbaca setelah yang dirujuknya dihapus —
  /// dan jejak pekerjaan yang hilang bersama tenantnya adalah jejak yang tidak
  /// bisa menjawab "apa yang terjadi sebelum dihapus".
  tenantId  Int? @map("tenant_id")
  companyId Int? @map("company_id")

  /// KECIL dengan sengaja: parameter, bukan isi. Satu ekspor menyimpan rentang
  /// tanggal dan id laporan — bukan barisnya. Isi besar masuk penyimpanan objek
  /// dan yang tercatat di sini hanya kuncinya (`resultRef`).
  payload Json

  /// `queued` · `claimed` · `done` · `failed` · `dead` — lihat `contract/`.
  /// `failed` BUKAN akhir: ia menunggu percobaan berikutnya. `dead` yang akhir.
  status String @default("queued") @db.VarChar(10)

  /// Penerbitan dua kali menabrak constraint, bukan menghasilkan dua pekerjaan.
  /// NULL diizinkan dan berarti "boleh berulang" — Postgres membolehkan banyak
  /// NULL pada kolom unik, dan itu persis yang dibutuhkan pekerjaan demi
  /// kenyamanan pengguna: menekan tombol ekspor dua kali memang dua pekerjaan.
  dedupeKey String? @unique @map("dedupe_key") @db.VarChar(200)

  attempts    Int @default(0)
  maxAttempts Int @default(3) @map("max_attempts")

  /// Penundaan & *backoff* eksponensial. Pengambilan menuntut `runAfter <= now()`.
  runAfter DateTime @default(now()) @map("run_after")

  /// `claimedAt` DIPERBARUI BERKALA oleh pekerja selama bekerja (*lease* yang
  /// diperpanjang), bukan disetel sekali saat klaim. Ambang tetap saja salah:
  /// ekspor 30 menit melewati ambang mana pun yang masuk akal untuk mendeteksi
  /// pekerja mati, lalu diklaim pekerja kedua SEMENTARA yang pertama masih
  /// berjalan — dan untuk `tenant.backup` itu dua dump menulis ke satu kunci
  /// objek.
  claimedAt DateTime? @map("claimed_at")
  claimedBy String?   @map("claimed_by") @db.VarChar(100)

  /// Kegagalan adalah isi paling berharga di tabel ini, jadi ia tidak pernah
  /// ditimpa menjadi kosong saat percobaan berikutnya dimulai.
  lastError String? @map("last_error") @db.Text

  /// KUNCI OBJEK, bukan isinya — dan BUKAN kapabilitas. Memegang kuncinya
  /// bukan izin untuk membacanya: penyimpanan objek privat, unduhan lewat rute
  /// aplikasi, dan izin diperiksa SAAT MENGUNDUH (pekerjaan hidup berjam-jam;
  /// orang yang aksesnya dicabut di antaranya tidak boleh tetap menerima
  /// hasilnya).
  resultRef String? @map("result_ref") @db.VarChar(500)

  /// Urutan DALAM satu jalur. Besar lebih dulu.
  priority Int @default(0)

  /// Pembatalan: diminta, bukan dipaksakan. Pekerja memeriksanya di antara
  /// langkah — membunuh proses di tengah tulisan adalah cara menghasilkan
  /// keadaan separuh.
  cancelRequested Boolean @default(false) @map("cancel_requested")

  /// 0–100, untuk ditampilkan. Tidak pernah dipakai mengambil keputusan.
  progress Int @default(0)

  /// Diisi saat `done`/`dead` — dasar pengarsipan dan metrik durasi.
  finishedAt DateTime? @map("finished_at")

  /// Kapan percobaan INI mulai berjalan — disetel SEKALI pada klaim, dan
  /// `renewLease` TIDAK menyentuhnya. Itu seluruh alasan ia ada di samping
  /// `claimedAt`: yang terakhir diperpanjang berkala, jadi
  /// `finishedAt - claimedAt` adalah jarak dari perpanjangan terakhir — bukan
  /// durasi. Histogram yang dibangun darinya terlihat rapi dan seluruhnya
  /// salah.
  ///
  /// Disetel ULANG pada percobaan berikutnya: yang diukur durasi PERCOBAAN.
  /// Rentang dari penerbitan sampai berhasil sudah terbaca dari `createdAt`,
  /// dan mencampurnya berarti pekerjaan yang di-*backoff* satu jam muncul
  /// sebagai pekerjaan yang BERJALAN satu jam.
  ///
  /// NULL pada baris yang selesai sebelum kolom ini ada — tanpa backfill, sebab
  /// satu-satunya bahan terkaannya adalah `claimedAt`.
  startedAt DateTime? @map("started_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, kind])
  @@index([tenantId, companyId, status])
  @@index([finishedAt])
  @@map("jobs")
}

/// Potret runtime proses Node/Bun — bahan vonis pemicu tahap 1d (09 §3.3, §9).
/// Dua bentuk baris di satu tabel, dibedakan `sampleKind`:
///   `loop` — satu per proses per jendela 5 menit: tunda event loop p50/p99/max
///            + memori saat dipotret;
///   `job`  — satu per percobaan pekerjaan di pelari jalur Node: puncak memori
///            dan lamanya.
/// Dipangkas `pruneRuntimeSamples` setelah 14 hari, seperti baris `jobs` `done`.
/// Lihat migration `0008_runtime_samples` untuk kenapa ini tabel sendiri dan
/// bukan kolom di `jobs`.
model RuntimeSample {
  id Int @id @default(autoincrement())

  /// `app-customer`, atau nama JALUR untuk pelari (`interactive`, `ledger`, …).
  source String @db.VarChar(40)

  /// `hostname:pid` — menunjuk container yang memotret; replika kedua tidak
  /// boleh terbaca sebagai proses yang sama.
  instance String @db.VarChar(100)

  /// `node` | `bun` — keduanya mencatat histogram event loop dengan dasar
  /// berbeda (lihat `loopDelayMs`), dan pembaca angka perlu tahu yang mana.
  runtime String @db.VarChar(10)

  /// `loop` | `job` — String + union TS, konvensi docs/DATABASE.md.
  sampleKind String @map("sample_kind") @db.VarChar(10)

  /// Hanya `loop`. Milidetik TUNDA (sudah dikoreksi per runtime).
  windowMs  Int?     @map("window_ms")
  loopP50Ms Decimal? @map("loop_p50_ms") @db.Decimal(10, 2)
  loopP99Ms Decimal? @map("loop_p99_ms") @db.Decimal(10, 2)
  loopMaxMs Decimal? @map("loop_max_ms") @db.Decimal(10, 2)

  /// Hanya `job`. Bukan FK: baris `jobs` dipangkas pada retensi yang sama dan
  /// sampel yang ikut terhapus bersama pekerjaannya kehilangan gunanya lebih
  /// cepat daripada yang perlu.
  jobId      Int?    @map("job_id")
  jobKind    String? @map("job_kind") @db.VarChar(40)
  durationMs Int?    @map("duration_ms")

  /// `loop`: nilai saat dipotret. `job`: PUNCAK selama percobaan (heap = batas
  /// bawah tercuplik; RSS = tepat bila percobaan ini mencetak tanda air proses).
  heapUsedBytes BigInt @map("heap_used_bytes")
  rssBytes      BigInt @map("rss_bytes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sampleKind, source, createdAt])
  @@index([createdAt])
  @@index([jobId])
  @@map("runtime_samples")
}

/// Jejak relay outbox per buku (09 §4, migration kendali 0012). Satu baris per
/// perusahaan, di-upsert relay tiap putaran. Pembacanya `/api/health`,
/// `watch:health`, dan konsol `/scheduler` — tak satu pun menyapu buku PT.
/// Bukan FK: jejak tetap terbaca sesudah perusahaannya dihapus.
model OutboxRelayBook {
  id                  Int       @id @default(autoincrement())
  companyId           Int       @unique @map("company_id")
  /// Putaran relay terakhir yang MENYENTUH buku ini (berhasil atau gagal).
  lastPassAt          DateTime  @map("last_pass_at")
  /// `created_at` baris outbox tertua yang belum terbit; NULL = tidak ada.
  oldestUnpublishedAt DateTime? @map("oldest_unpublished_at")
  unpublishedCount    Int       @default(0) @map("unpublished_count")
  publishedLastPass   Int       @default(0) @map("published_last_pass")
  /// Galat putaran terakhir (buku tak terjangkau, kendali menolak). NULL = sehat.
  lastError           String?   @map("last_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([lastPassAt])
  @@map("outbox_relay_books")
}
