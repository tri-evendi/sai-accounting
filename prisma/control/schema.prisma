// ─────────────────────────────────────────────────────────────────────────────
// BASIS DATA KENDALI (control database) — issue #104
//
// Satu basis data kecil yang TIDAK berisi angka akuntansi apa pun. Isinya hanya
// tiga hal: siapa penggunanya, ada perusahaan apa saja, dan siapa boleh masuk ke
// perusahaan yang mana. Seluruh buku besar — jurnal, faktur, stok, kas — hidup di
// basis data MILIK PERUSAHAAN masing-masing (`prisma/schema.prisma`), satu basis
// data per PT, tanpa satu pun kolom `company_id`.
//
// KENAPA DIPISAH BEGINI. Isolasinya FISIK, bukan sekadar teruji: satu klausa
// `WHERE company_id = …` yang terlupa pada tenancy per-baris akan menampilkan
// buku besar satu klien kepada klien lain — di produk akuntansi itu bukan bug,
// itu insiden. Dengan basis data terpisah kebocoran seperti itu TIDAK MUNGKIN
// terjadi, bukan "tidak terjadi karena tesnya lengkap". Preseden yang sudah
// dikenal akuntan Indonesia: berkas perusahaan Accurate/MYOB.
//
// KENAPA IDENTITAS ADA DI SINI, BUKAN DI TIAP PERUSAHAAN. Kalau `users` hidup di
// dalam basis data tiap perusahaan, satu orang punya beberapa akun terpisah
// dengan kata sandi terpisah — dan "satu login mencakup semua perusahaan", yang
// merupakan seluruh alasan issue #104 ada, menjadi mustahil. Ongkosnya satu
// basis data lagi untuk dikelola; itu harga yang dibayar sadar-sadar.
//
// AKIBATNYA, dan ini disengaja: tabel di basis data perusahaan TIDAK BOLEH punya
// foreign key ke `users`. `periods.closed_by_id` dan `user_permission_overrides.
// user_id` menyimpan id pengguna GLOBAL sebagai angka biasa, tanpa FK — sebab FK
// tidak bisa menyeberangi basis data. Penegakannya pindah ke lapisan aplikasi.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/control"
}

datasource db {
  provider = "mysql"
}

/// PELANGGAN platform (issue #134, epik #133) — pihak yang berlangganan dan
/// membayar. Satu tenant memegang beberapa Company (PT) dan beberapa User.
///
/// KENAPA DI BASIS DATA KENDALI, BUKAN DI `sai_platform`: `tenants` dibaca di
/// jalur panas (pengguna ini tenant mana → perusahaan apa saja → apakah
/// suspended), dan pendaftaran harus atomik — Tenant + User(owner) +
/// TenantMembership lahir dalam SATU transaksi. Lihat docs/MULTI-TENANT.md §4A.
model Tenant {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)
  name String @db.VarChar(150)

  /// pending_verification | trialing | active | past_due | suspended | cancelled
  /// String + z.enum (`TENANT_STATUSES` di src/lib/constants.ts), snake_case —
  /// konvensi docs/DATABASE.md, bukan enum Prisma.
  status String @default("pending_verification") @db.VarChar(30)

  planKey     String    @default("trial") @map("plan_key") @db.VarChar(30)
  trialEndsAt DateTime? @map("trial_ends_at")

  /// Batas dari paket, DISALIN saat paket berubah — bukan dibaca dari tabel
  /// paket saat dipakai. Alasannya sama dengan snapshot peran penyetuju di
  /// aturan persetujuan: menaikkan harga paket tidak boleh diam-diam
  /// mempersempit pelanggan yang sudah berjalan.
  maxCompanies Int @default(1) @map("max_companies")
  maxUsers     Int @default(3) @map("max_users")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  companies   Company[]
  users       User[]
  memberships TenantMembership[]

  @@index([status])
  @@map("tenants")
}

/// Keanggotaan TINGKAT TENANT: menjawab "boleh membuat perusahaan? boleh
/// mengubah paket?" — pertanyaan yang harus terjawab TANPA perusahaan aktif,
/// karena pelanggan baru belum punya satu pun. BUKAN pengganti `Membership`
/// (peran per-PT), melainkan lapisan di atasnya.
model TenantMembership {
  id       Int @id @default(autoincrement())
  tenantId Int @map("tenant_id")
  userId   Int @map("user_id")

  /// owner | admin | member (`TENANT_ROLE_VALUES` di src/lib/constants.ts).
  /// BUKAN peran akuntansi — itu milik `memberships`. Minimal SATU owner per
  /// tenant; anti-lockout ditegakkan di lapisan aplikasi (`tenant-directory`).
  role String @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Satu peran tenant per (tenant, pengguna) — sama alasannya dengan
  /// `memberships`: dua peran bukan keadaan yang bisa dijawab penjaga.
  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_memberships")
}

/// Satu PT = satu baris di sini = satu basis data sendiri.
model Company {
  id   Int    @id @default(autoincrement())
  /// Dipakai di URL dan sebagai bagian nama basis data. Huruf kecil, angka, dan
  /// tanda hubung — divalidasi di `lib/validations/company.ts`, bukan hanya di UI.
  slug String @unique @db.VarChar(50)
  name String @db.VarChar(150)

  /// NAMA basis datanya saja, bukan URL lengkap. Host, pengguna, dan kata sandi
  /// diambil dari `DATABASE_URL_TEMPLATE` di environment.
  ///
  /// KENAPA BUKAN URL PENUH: menyimpan URL berarti menyimpan kata sandi basis
  /// data di dalam basis data — satu baris SELECT dan seluruh kredensial setiap
  /// perusahaan ikut terbawa. Nama basis data bukan rahasia; kredensialnya tetap
  /// hanya ada di environment, tempat rahasia memang seharusnya tinggal.
  databaseName String @unique @map("database_name") @db.VarChar(64)

  /// Perusahaan dinonaktifkan, bukan dihapus: bukunya masih ada, kewajiban
  /// pajaknya masih ada, dan riwayatnya masih harus bisa dibuka. `false` =
  /// hilang dari pemilih dan tak bisa dibuka; basis datanya tidak disentuh.
  isActive Boolean @default(true) @map("is_active")

  /// Tenant PEMILIK perusahaan ini (issue #134). Nullable di TIPE hanya untuk
  /// masa transisi adopsi (migration 0002 → skrip adopsi → 0003 NOT NULL);
  /// kode yang MEMBUAT perusahaan wajib selalu mengisinya — basis data menolak
  /// NULL sejak 0003. `Restrict`: menghapus tenant yang masih punya perusahaan
  /// berarti membuang registry buku yang wajib disimpan — tidak boleh terjadi
  /// lewat cascade yang sunyi.
  tenantId Int?    @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships Membership[]

  @@index([isActive])
  @@index([tenantId])
  @@map("companies")
}

/// Identitas orang. Satu baris per manusia, berapa pun perusahaan yang dipegangnya.
model User {
  id       Int     @id @default(autoincrement())
  /// Sejak issue #136 BUKAN pengenal login dan BUKAN unik se-pemasangan
  /// (migration 0004 membuang indeks uniknya): Pelanggan B boleh punya `budi`
  /// walau Pelanggan A sudah punya. Tinggal sebagai nama tampilan/panggilan;
  /// keunikan per-TENANT ditegakkan lapisan aplikasi (`users-directory.ts`).
  username String  @db.VarChar(50)
  password String  @db.VarChar(255)
  name     String? @db.VarChar(100)

  /// PENGENAL LOGIN sejak issue #136, unik global — email tidak mengejutkan
  /// siapa pun sebagai pengenal, berbeda dengan username unik se-pemasangan.
  /// Nullable di TIPE hanya untuk masa transisi adopsi (0002 → skrip adopsi
  /// mengisi email dari data yang disiapkan operator → 0003 NOT NULL); kode
  /// yang MEMBUAT pengguna wajib selalu mengisinya.
  email           String?   @unique @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at")

  /// Tenant PEMILIK akun ini. Satu user milik TEPAT SATU tenant — tidak ada
  /// akun yang menyeberang antar-tenant (docs/MULTI-TENANT.md §2). Nullable
  /// hanya untuk masa transisi adopsi, sama seperti `companies.tenant_id`.
  tenantId Int?    @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Wajib mengganti kata sandi sebelum boleh membuka apa pun. Milik IDENTITAS,
  /// bukan keanggotaan: kata sandinya satu untuk semua perusahaan, jadi
  /// kewajiban menggantinya juga satu.
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  passDate           DateTime? @map("pass_date")

  /// Pencabutan sesi (audit RBAC fase 3). JWT menyimpan angka ini saat login;
  /// revalidasi berkala membandingkannya dengan DB — beda = sesi mati. Tetap di
  /// tingkat PENGGUNA: mencabut sesi berarti mencabutnya di semua perusahaan,
  /// yang memang perilaku yang benar saat kata sandi di-reset.
  sessionVersion Int @default(1) @map("session_version")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships         Membership[]
  tenantMemberships   TenantMembership[]
  passwordResetTokens PasswordResetToken[]

  @@index([tenantId])
  @@index([tenantId, username])
  @@map("users")
}

/// Token atur-ulang kata sandi (issue #136) — disimpan TER-HASH (SHA-256),
/// berbatas waktu, sekali pakai. Token mentah hanya pernah hidup di dalam
/// surel yang dikirim ke pemiliknya; baris di sini tidak cukup untuk mengatur
/// ulang apa pun tanpa surel itu.
model PasswordResetToken {
  id     Int @id @default(autoincrement())
  userId Int @map("user_id")

  /// SHA-256 hex dari token mentah. Unik: satu token satu baris.
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  /// Terisi = sudah dipakai; token yang sama tidak pernah bekerja dua kali.
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Pengguna × perusahaan × peran. Inilah yang tidak bisa dinyatakan oleh satu
/// kolom `users.role`: seseorang bisa Direktur Utama di PT A dan Kepala Gudang
/// di PT B, dan kedua kenyataan itu harus hidup berdampingan.
/// PENDAFTARAN MANDIRI yang belum terverifikasi (issue #138) — keadaan
/// "pending_verification" dari perjalanan §7.1 hidup DI SINI, bukan sebagai
/// baris `tenants`: Tenant + User(owner) + TenantMembership baru lahir — dalam
/// SATU transaksi — ketika tautan verifikasi diklik. Sebelum itu tidak ada
/// apa pun yang menempati email unik, tidak ada basis data yang dibuat, dan
/// pendaftaran yang ditinggalkan kedaluwarsa tanpa menyisakan akun setengah
/// jadi yang harus dibersihkan.
model Registration {
  id Int @id @default(autoincrement())

  /// BUKAN unik: orang boleh meminta ulang surel verifikasinya; token termuda
  /// yang menang (yang lama ditandai terpakai oleh permintaan baru).
  email String @db.VarChar(255)
  name  String @db.VarChar(100)

  /// bcrypt — kata sandi diketik sekali saat mendaftar dan langsung di-hash;
  /// nilai mentahnya tidak pernah disimpan di mana pun.
  passwordHash String @map("password_hash") @db.VarChar(255)

  /// SHA-256 hex token verifikasi (pola `password_reset_tokens`): token mentah
  /// hanya hidup di dalam surel.
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  /// Terisi = sudah diverifikasi ATAU digantikan permintaan yang lebih baru.
  usedAt    DateTime? @map("used_at")

  /// Jejak persetujuan S&K — kapan kotaknya dicentang (dikirim bersama form).
  termsAcceptedAt DateTime @map("terms_accepted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([expiresAt])
  @@map("registrations")
}

/// Penghitung pembatas laju PERSISTEN (issue #138) — `lib/rate-limit.ts` yang
/// lama menghitung di `Map` memori: hilang saat proses dimulai ulang dan tidak
/// terbagi antar-instance. Untuk /login internal itu diterima; untuk endpoint
/// yang TERBUKA KE INTERNET (/register, atur-ulang kata sandi) tidak. Baris =
/// satu kunci (mis. `register:ip:1.2.3.4`) dengan jendela tetap; penambahannya
/// atomik lewat `INSERT … ON DUPLICATE KEY UPDATE` (lib/rate-limit-persistent.ts).
model RateLimitCounter {
  id Int @id @default(autoincrement())

  key             String   @unique @db.VarChar(160)
  windowStartedAt DateTime @map("window_started_at")
  count           Int      @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([updatedAt])
  @@map("rate_limit_counters")
}

model Membership {
  id        Int @id @default(autoincrement())
  userId    Int @map("user_id")
  companyId Int @map("company_id")

  /// Peran DI PERUSAHAAN INI. Nilainya sama dengan `users.role` yang lama
  /// (managing_director | finance_manager | warehouse_head | administrator, plus
  /// peran kustom) — tapi peran kustom adalah DATA di basis data perusahaan
  /// (tabel `roles`), jadi nilai di sini hanya sah untuk perusahaan itu.
  role String @db.VarChar(20)

  /// Preferensi tampilan "Mode Akuntan" (issue #11). NULL = ikut bawaan peran.
  /// Milik KEANGGOTAAN, bukan pengguna: bawaannya diturunkan dari peran, dan
  /// peran berbeda per perusahaan — orang yang sama bisa butuh permukaan
  /// akuntansi di PT A dan tidak di PT B.
  accountantMode Boolean? @map("accountant_mode")

  /// Dicabut aksesnya ke perusahaan ini tanpa menghapus jejak bahwa ia pernah
  /// punya. Menghapus baris juga sah untuk keanggotaan yang salah buat.
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Satu peran per (pengguna, perusahaan). Dua peran di satu perusahaan bukan
  /// keadaan yang bisa dijawab penjaga izin tanpa menebak.
  @@unique([userId, companyId])
  @@index([companyId])
  @@index([isActive])
  @@map("memberships")
}
