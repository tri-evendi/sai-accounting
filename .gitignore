# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/dist
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# … kecuali CONTOHNYA (#159 temuan 6): README & scripts/setup.sh menyuruh
# `cp .env.example .env`, tapi pola `.env*` di atas diam-diam menelan berkas
# contohnya sendiri — clone baru tidak pernah menerimanya.
!.env.example
!.env.docker.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
# Klien basis data kendali (issue #104) — sama seperti klien perusahaan, dihasilkan
# oleh `npm run db:generate`, bukan disimpan di repo.
/src/generated/control
# Klien basis data platform (issue #137) — idem.
/src/generated/platform
# ...dan direktori INDUKNYA, yang selama ini tidak disebut. Worktree agent tidak
# punya klien hasil generate (tsc memuntahkan ~200 galat palsu tanpanya), jadi
# yang biasa dilakukan adalah men-symlink `src/generated` ke checkout utama —
# lalu satu `git add -A` menjadikan symlink itu commit, dan di checkout utama ia
# menunjuk dirinya sendiri: klien Prisma lenyap, 24 berkas tes merah, dan
# penyebabnya tidak terlihat di diff mana pun. Terjadi sungguhan sebelum
# `Merge PR #236`.
/src/generated/

# local audit trail (sensitive)
# Sejak #104 jejak audit pindah ke `data/audit/<slug>/audit.jsonl` — satu
# tingkat lebih dalam, sehingga pola lama `/data/audit/*.jsonl` berhenti cocok
# dan berkasnya muncul sebagai untracked yang siap ikut ter-commit. Isinya
# username, peran, dan alamat IP sungguhan. Diabaikan per-folder, bukan
# per-berkas, supaya penambahan PT berikutnya tidak perlu diingat lagi.
/data/audit/

# runtime logs
/logs/

# database dumps (never commit production data)
*.sql
!prisma/migrations/**/*.sql
# Sejak #104 ada DUA folder migration. Tanpa baris ini, `*.sql` di atas menelan
# migration basis data KENDALI: repo mengira dirinya lengkap, lalu
# `db:migrate:control` di mesin baru berhenti dengan "No migration found".
!prisma/control/migrations/**/*.sql
# … dan sejak #137 TIGA: migration basis data PLATFORM ikut dikecualikan.
!prisma/platform/migrations/**/*.sql

# transient agent worktrees
/.claude/worktrees/

# python caches from local tooling/skills
__pycache__/
*.pyc

# Local DB dumps / backups — never commit
backups/

# Keadaan RUNTIME di dalam `data/`, bukan kode.
#   mail-outbox/  surel yang DITANGKAP transport `file` (MAIL_TRANSPORT=file);
#                 pada pemasangan nyata isinya alamat & badan surel sungguhan.
#   *.log         log server.
# ⚠ Sengaja BUKAN `/data/` polos: `data/audit/.gitkeep` memang terlacak supaya
# direktorinya ada sejak checkout pertama.
/data/mail-outbox/
/data/*.log
