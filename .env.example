# ─────────────────────────────────────────────────────────────
# Environment pemasangan LOKAL / VPS tanpa Docker — salin lalu isi:
#   cp .env.example .env
# Untuk Docker Compose pakai contoh satunya: cp .env.docker.example .env
# ─────────────────────────────────────────────────────────────

# ─── App → basis data PERUSAHAAN PERTAMA ─────────────────────
# Mesinnya PostgreSQL (sejak 15 Okt 2026). URL `mysql://` DITOLAK saat start
# dengan pesan yang menyebut #636 — MariaDB sudah dicabut.
# Sejak multi-perusahaan (issue #104) URL ini bukan lagi "basis data aplikasi"
# melainkan basis data PERUSAHAAN PERTAMA — sekaligus contoh kredensial yang
# dipinjam untuk perusahaan lain (lihat COMPANY_DATABASE_URL_TEMPLATE).
# Sandi berkarakter khusus (@ : / dsb.) harus di-URL-encode.
DATABASE_URL="postgres://sai:change-me@localhost:5432/sai_production"

# ─── Basis data KENDALI (WAJIB sejak issue #104) ──────────────
# Berisi pengguna, daftar perusahaan, dan keanggotaan — TANPA satu pun angka
# akuntansi. Buku besar setiap PT tetap di basis datanya sendiri.
# Buat sekali:  CREATE DATABASE sai_control;  lalu `bun run db:migrate:all`.
CONTROL_DATABASE_URL="postgres://sai:change-me@localhost:5432/sai_control"

# Kredensial yang dipinjam saat membuka basis data perusahaan; NAMA basis
# datanya diambil dari registry (`companies.database_name`), bukan dari sini.
# Boleh dikosongkan — DATABASE_URL di atas dipakai sebagai cadangan.
# COMPANY_DATABASE_URL_TEMPLATE="postgres://sai:change-me@localhost:5432/template"

# ⚠ HAK YANG WAJIB ADA SEBELUM /companies/new BISA DIPAKAI. Menambah PT dari
# aplikasi berarti CREATE DATABASE, dan role `sai` tidak punya hak itu kecuali
# diberikan — tanpanya penyediaan berhenti di tahap 2 dengan SQLSTATE 42501.
# Jalankan sekali, sebagai superuser:
#   ALTER ROLE sai CREATEDB;
# Awalan nama (`sai_t{tenantId}_{slug}`) ditegakkan kode. Selengkapnya:
# docs/MULTI-COMPANY.md §3 ("Perusahaan berikutnya"), termasuk jalur untuk
# hosting yang memang tidak memberikan hak itu (administrator membuat basis
# datanya manual).

# Kredensial khusus untuk MEMBUAT basis data perusahaan (OPSIONAL).
# Tanpa ini penyediaan memakai CONTROL_DATABASE_URL. Isi hanya bila hak
# CREATEDB ingin dipisahkan ke role tersendiri — role aplikasi tetap butuh hak
# baca-tulis atas basis data yang dihasilkannya.
# PROVISION_DATABASE_URL="postgres://sai_provision:change-me@localhost:5432/sai_control"

# ─── Basis data PLATFORM (OPSIONAL — issue #137) ─────────────
# Data langganan & penagihan SaaS: plans, subscriptions, payments,
# platform_invoices, usage_counters. TIDAK dibutuhkan pemasangan multi-PT satu
# grup usaha — biarkan kosong, dan `db:migrate:all` melewatinya dengan
# peringatan. Aplikasi tetap bisa login & membuka buku saat basis data ini
# MATI (penagihan mati ≠ login mati) — lihat packages/platform/src/platform-db.ts.
#
# ⚠ TANPA variabel ini TIDAK ADA yang error — penagihan hanya absen DIAM-DIAM
# (#159 temuan 6): paket, tagihan, dan penjadwal langganan tidak berjalan.
# Kalau pemasangan Anda memang SaaS bertagihan, isi ini.
#
# ⚠ HAK AKSES: idealnya role aplikasi (`sai`) tidak menyentuh `sai_platform`
# di jalur permintaan biasa — pakai ROLE TERPISAH di URL ini (contoh
# `sai_billing`) yang hanya berhak atas `sai_platform`:
#   CREATE ROLE sai_billing LOGIN PASSWORD '<sandi-lain>';
#   CREATE DATABASE sai_platform OWNER sai_billing;
# PLATFORM_DATABASE_URL="postgres://sai_billing:change-me@localhost:5432/sai_platform"

# Koneksi per klien perusahaan (default 2) dan berapa klien boleh hidup
# bersamaan (default 4). N perusahaan x batas koneksi adalah anggaran nyata
# di mesin kecil — lihat src/lib/company-clients.ts.
DB_CONNECTION_LIMIT=2
COMPANY_CLIENT_POOL_MAX=4
# Koneksi untuk basis data kendali saja (default 2).
CONTROL_DB_CONNECTION_LIMIT=2
# Koneksi untuk basis data platform saja (default 1 — penagihan bukan jalur panas).
PLATFORM_DB_CONNECTION_LIMIT=1
# Berapa perusahaan dimigrasikan BERSAMAAN saat rilis (default 2, plafon 8).
# Tiap pelaksana satu proses Prisma CLI + satu backend PostgreSQL, dan
# migration berjalan sementara aplikasi masih melayani — angka besar di sini
# adalah OOM-killer yang dijadwalkan sendiri pada langkah rilis.
COMPANY_MIGRATE_CONCURRENCY=2

# ─── NextAuth (WAJIB) ─────────────────────────────────────────
# Buat dengan: openssl rand -base64 32
AUTH_SECRET=""
# URL publik tempat pengguna membuka aplikasi (tanpa garis miring akhir).
# Pengembangan lokal cukup bawaan Next (http://localhost:3000) — biarkan
# terkomentar. WAJIB diisi di produksi.
# AUTH_URL="https://app.contoh.co.id"
# Wajib true bila di belakang reverse proxy (nginx/Traefik).
# AUTH_TRUST_HOST=true

# ─── Surel (issue #136) ───────────────────────────────────────
# Bawaan `file`: surel DITANGKAP ke data/mail-outbox/*.eml, tidak pernah
# meninggalkan mesin — mode pengembangan. `smtp` hanya dihormati bila
# NODE_ENV=production DAN SMTP_URL terisi; lihat src/lib/mailer-core.ts.
# MAIL_TRANSPORT=file
# SMTP_URL="smtp://user:pass@smtp.contoh.co.id:587"
# MAIL_FROM="SAI Accounting <no-reply@contoh.co.id>"

# ─── Alamat penjualan untuk paket berharga rundingan ──────────
# Dipakai kartu paket `contactOnly` di halaman pendaratan publik `/`
# (src/components/landing/landing-pricing.tsx).
#
# ⚠ TANPA ini kartu Enterprise TIDAK punya tombol. Yang tampil sebagai
# gantinya adalah kalimat "alamat kontak belum disetel pada pemasangan ini" —
# pesan untuk PEMASANG, dibaca oleh calon pelanggan. Katalog bawaan memang
# mengapalkan satu paket rundingan (scripts/seed-plans.ts), jadi keadaan itu
# adalah bawaan setiap pemasangan sampai baris ini diisi.
PLATFORM_CONTACT_EMAIL="sales@contoh.co.id"

# ─── Nomor WhatsApp penjualan/dukungan (opsional) ─────────────
# Dipakai seksi kontak halaman pendaratan publik `/` sebagai tombol
# "Chat lewat WhatsApp" (src/components/landing/landing-contact.tsx, lewat
# src/lib/contact-channels.ts). Kosong = tombolnya TIDAK dirender; tidak ada
# nilai bawaan.
#
# Bentuk: nomor internasional TANPA `+`, spasi, atau nol awal — persis seperti
# yang diterima https://wa.me/<nomor>. Nomor yang salah bentuk ditolak
# scripts/check-env.mjs saat mulai (dan tidak dirender), sebab tautan ke nomor
# yang salah baru ketahuan dari calon pelanggan.
# PLATFORM_CONTACT_WHATSAPP="6281234567890"

# ─── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="SAI Management"
TZ="Asia/Jakarta"
# Produksi: wajib NODE_ENV=production (diperiksa scripts/check-env.mjs).
# NODE_ENV=production

# Seed demo saja — JANGAN PERNAH true di produksi.
# ALLOW_SEED=true
