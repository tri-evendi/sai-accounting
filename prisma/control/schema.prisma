// ─────────────────────────────────────────────────────────────────────────────
// BASIS DATA KENDALI (control database) — issue #104
//
// Satu basis data kecil yang TIDAK berisi angka akuntansi apa pun. Isinya hanya
// tiga hal: siapa penggunanya, ada perusahaan apa saja, dan siapa boleh masuk ke
// perusahaan yang mana. Seluruh buku besar — jurnal, faktur, stok, kas — hidup di
// basis data MILIK PERUSAHAAN masing-masing (`prisma/schema.prisma`), satu basis
// data per PT, tanpa satu pun kolom `company_id`.
//
// KENAPA DIPISAH BEGINI. Isolasinya FISIK, bukan sekadar teruji: satu klausa
// `WHERE company_id = …` yang terlupa pada tenancy per-baris akan menampilkan
// buku besar satu klien kepada klien lain — di produk akuntansi itu bukan bug,
// itu insiden. Dengan basis data terpisah kebocoran seperti itu TIDAK MUNGKIN
// terjadi, bukan "tidak terjadi karena tesnya lengkap". Preseden yang sudah
// dikenal akuntan Indonesia: berkas perusahaan Accurate/MYOB.
//
// KENAPA IDENTITAS ADA DI SINI, BUKAN DI TIAP PERUSAHAAN. Kalau `users` hidup di
// dalam basis data tiap perusahaan, satu orang punya beberapa akun terpisah
// dengan kata sandi terpisah — dan "satu login mencakup semua perusahaan", yang
// merupakan seluruh alasan issue #104 ada, menjadi mustahil. Ongkosnya satu
// basis data lagi untuk dikelola; itu harga yang dibayar sadar-sadar.
//
// AKIBATNYA, dan ini disengaja: tabel di basis data perusahaan TIDAK BOLEH punya
// foreign key ke `users`. `periods.closed_by_id` dan `user_permission_overrides.
// user_id` menyimpan id pengguna GLOBAL sebagai angka biasa, tanpa FK — sebab FK
// tidak bisa menyeberangi basis data. Penegakannya pindah ke lapisan aplikasi.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/control"
}

datasource db {
  provider = "mysql"
}

/// PELANGGAN platform (issue #134, epik #133) — pihak yang berlangganan dan
/// membayar. Satu tenant memegang beberapa Company (PT) dan beberapa User.
///
/// KENAPA DI BASIS DATA KENDALI, BUKAN DI `sai_platform`: `tenants` dibaca di
/// jalur panas (pengguna ini tenant mana → perusahaan apa saja → apakah
/// suspended), dan pendaftaran harus atomik — Tenant + User(owner) +
/// TenantMembership lahir dalam SATU transaksi. Lihat docs/MULTI-TENANT.md §4A.
model Tenant {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)
  name String @db.VarChar(150)

  /// pending_verification | trialing | active | past_due | suspended | cancelled
  /// String + z.enum (`TENANT_STATUSES` di src/lib/constants.ts), snake_case —
  /// konvensi docs/DATABASE.md, bukan enum Prisma.
  status String @default("pending_verification") @db.VarChar(30)

  planKey     String    @default("trial") @map("plan_key") @db.VarChar(30)
  trialEndsAt DateTime? @map("trial_ends_at")

  /// Batas dari paket, DISALIN saat paket berubah — bukan dibaca dari tabel
  /// paket saat dipakai. Alasannya sama dengan snapshot peran penyetuju di
  /// aturan persetujuan: menaikkan harga paket tidak boleh diam-diam
  /// mempersempit pelanggan yang sudah berjalan.
  maxCompanies Int @default(1) @map("max_companies")
  maxUsers     Int @default(3) @map("max_users")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  companies        Company[]
  users            User[]
  memberships      TenantMembership[]
  deletionRequests TenantDeletionRequest[]
  invitations Invitation[]

  @@index([status])
  @@map("tenants")
}

/// Keanggotaan TINGKAT TENANT: menjawab "boleh membuat perusahaan? boleh
/// mengubah paket?" — pertanyaan yang harus terjawab TANPA perusahaan aktif,
/// karena pelanggan baru belum punya satu pun. BUKAN pengganti `Membership`
/// (peran per-PT), melainkan lapisan di atasnya.
model TenantMembership {
  id       Int @id @default(autoincrement())
  tenantId Int @map("tenant_id")
  userId   Int @map("user_id")

  /// owner | admin | member (`TENANT_ROLE_VALUES` di src/lib/constants.ts).
  /// BUKAN peran akuntansi — itu milik `memberships`. Minimal SATU owner per
  /// tenant; anti-lockout ditegakkan di lapisan aplikasi (`tenant-directory`).
  role String @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Satu peran tenant per (tenant, pengguna) — sama alasannya dengan
  /// `memberships`: dua peran bukan keadaan yang bisa dijawab penjaga.
  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_memberships")
}

/// Satu PT = satu baris di sini = satu basis data sendiri.
model Company {
  id   Int    @id @default(autoincrement())
  /// Dipakai di URL dan sebagai bagian nama basis data. Huruf kecil, angka, dan
  /// tanda hubung — divalidasi di `lib/validations/company.ts`, bukan hanya di UI.
  ///
  /// UNIK PER TENANT sejak issue #153 (`@@unique([tenantId, slug])` di bawah),
  /// BUKAN se-pemasangan: keunikan global membuat pelanggan saling berebut nama
  /// ("pusat" milik siapa yang duluan) dan galat "sudah dipakai" membocorkan
  /// slug pelanggan lain — kelas kebocoran yang sama dengan §4.4
  /// docs/MULTI-TENANT.md pada username. Nama basis data turunannya ikut aman:
  /// `sai_t{tenantId}_{slug}` memuat id tenant, jadi slug kembar lintas tenant
  /// tidak pernah bertemu di ruang nama fisik.
  slug String @db.VarChar(50)
  name String @db.VarChar(150)

  /// NAMA basis datanya saja, bukan URL lengkap. Host, pengguna, dan kata sandi
  /// diambil dari `DATABASE_URL_TEMPLATE` di environment.
  ///
  /// KENAPA BUKAN URL PENUH: menyimpan URL berarti menyimpan kata sandi basis
  /// data di dalam basis data — satu baris SELECT dan seluruh kredensial setiap
  /// perusahaan ikut terbawa. Nama basis data bukan rahasia; kredensialnya tetap
  /// hanya ada di environment, tempat rahasia memang seharusnya tinggal.
  databaseName String @unique @map("database_name") @db.VarChar(64)

  /// Perusahaan dinonaktifkan, bukan dihapus: bukunya masih ada, kewajiban
  /// pajaknya masih ada, dan riwayatnya masih harus bisa dibuka. `false` =
  /// hilang dari pemilih dan tak bisa dibuka; basis datanya tidak disentuh.
  isActive Boolean @default(true) @map("is_active")

  /// Perusahaan CONTOH — bukunya berisi data buatan, bukan pembukuan sungguhan
  /// (issue #355).
  ///
  /// KENAPA FLAG SENDIRI, bukan menumpang status langganan: read-only yang sudah
  /// ada terikat pada tenant yang DITANGGUHKAN, dan memakainya di sini akan
  /// menampilkan "langganan Anda ditangguhkan" pada perusahaan yang justru
  /// dibuat untuk menyambut pengguna baru. Dua keadaan yang berbeda sama sekali
  /// tidak boleh berbagi satu penanda — persis alasan `/feature-inactive`
  /// dipisahkan dari "tidak punya akses" di issue #99.
  ///
  /// Akibatnya di aplikasi ada DUA: setiap tulisan ditolak penjaga
  /// (`lib/page-auth.ts` / `lib/auth-guard.ts`), dan setiap layarnya membawa
  /// spanduk yang menyebut isinya data contoh. Yang pertama menjaga bukunya,
  /// yang kedua menjaga penggunanya — sebuah buku demo yang bisa dikira nyata
  /// adalah kesalahan yang mahal di aplikasi akuntansi.
  ///
  /// `false` untuk setiap baris yang sudah ada: perusahaan sungguhan tidak
  /// pernah berubah arti karena kolom ini lahir.
  isDemo Boolean @default(false) @map("is_demo")

  /// Tenant PEMILIK perusahaan ini (issue #134). Nullable di TIPE hanya untuk
  /// masa transisi adopsi (migration 0002 → skrip adopsi → 0003 NOT NULL);
  /// kode yang MEMBUAT perusahaan wajib selalu mengisinya — basis data menolak
  /// NULL sejak 0003. `Restrict`: menghapus tenant yang masih punya perusahaan
  /// berarti membuang registry buku yang wajib disimpan — tidak boleh terjadi
  /// lewat cascade yang sunyi.
  tenantId Int?    @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships Membership[]
  /// Token API yang boleh membaca buku PT ini (issue #389).
  apiTokens   ApiToken[]
  invitations Invitation[]

  /// Slug unik DI DALAM tenantnya (issue #153) — lihat komentar `slug`.
  /// Dilahirkan bertahap dengan pola #134: migration 0008 menambah indeks ini
  /// BERDAMPINGAN dengan keunikan global lama, `scripts/
  /// prove-company-slug-scope.ts` membuktikan datanya bersih, baru 0009
  /// membuang yang global.
  @@unique([tenantId, slug])
  @@index([isActive])
  @@index([tenantId])
  @@map("companies")
}

/// Identitas orang. Satu baris per manusia, berapa pun perusahaan yang dipegangnya.
model User {
  id       Int     @id @default(autoincrement())
  /// Sejak issue #136 BUKAN pengenal login dan BUKAN unik se-pemasangan
  /// (migration 0004 membuang indeks uniknya): Pelanggan B boleh punya `budi`
  /// walau Pelanggan A sudah punya. Tinggal sebagai nama tampilan/panggilan;
  /// keunikan per-TENANT ditegakkan lapisan aplikasi (`users-directory.ts`).
  username String  @db.VarChar(50)
  password String  @db.VarChar(255)
  name     String? @db.VarChar(100)

  /// PENGENAL LOGIN sejak issue #136, unik global — email tidak mengejutkan
  /// siapa pun sebagai pengenal, berbeda dengan username unik se-pemasangan.
  /// Nullable di TIPE hanya untuk masa transisi adopsi (0002 → skrip adopsi
  /// mengisi email dari data yang disiapkan operator → 0003 NOT NULL); kode
  /// yang MEMBUAT pengguna wajib selalu mengisinya.
  email           String?   @unique @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at")

  /// Tenant PEMILIK akun ini. Satu user milik TEPAT SATU tenant — tidak ada
  /// akun yang menyeberang antar-tenant (docs/MULTI-TENANT.md §2). Nullable
  /// hanya untuk masa transisi adopsi, sama seperti `companies.tenant_id`.
  tenantId Int?    @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Wajib mengganti kata sandi sebelum boleh membuka apa pun. Milik IDENTITAS,
  /// bukan keanggotaan: kata sandinya satu untuk semua perusahaan, jadi
  /// kewajiban menggantinya juga satu.
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  passDate           DateTime? @map("pass_date")

  /// Pencabutan sesi (audit RBAC fase 3). JWT menyimpan angka ini saat login;
  /// revalidasi berkala membandingkannya dengan DB — beda = sesi mati. Tetap di
  /// tingkat PENGGUNA: mencabut sesi berarti mencabutnya di semua perusahaan,
  /// yang memang perilaku yang benar saat kata sandi di-reset.
  sessionVersion Int @default(1) @map("session_version")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships         Membership[]
  tenantMemberships   TenantMembership[]
  /// Token API yang ia terbitkan (issue #389).
  apiTokensCreated    ApiToken[]
  passwordResetTokens PasswordResetToken[]
  /// Pemberitahuan dalam aplikasi yang ditujukan kepadanya.
  notifications       Notification[]

  @@index([tenantId])
  @@index([tenantId, username])
  @@map("users")
}

/// Token atur-ulang kata sandi (issue #136) — disimpan TER-HASH (SHA-256),
/// berbatas waktu, sekali pakai. Token mentah hanya pernah hidup di dalam
/// surel yang dikirim ke pemiliknya; baris di sini tidak cukup untuk mengatur
/// ulang apa pun tanpa surel itu.
model PasswordResetToken {
  id     Int @id @default(autoincrement())
  userId Int @map("user_id")

  /// SHA-256 hex dari token mentah. Unik: satu token satu baris.
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  /// Terisi = sudah dipakai; token yang sama tidak pernah bekerja dua kali.
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Undangan staf lewat email (issue #139) — pengganti alur "admin mengetik
/// kata sandi orang lain": penerima menentukan kata sandinya SENDIRI lewat
/// tautan berbatas waktu. Baris di sini hanya untuk calon PENGGUNA BARU;
/// orang yang sudah punya akun setenant langsung ditambahkan keanggotaannya
/// (`addExistingUserToCompany`) tanpa baris undangan.
///
/// Token disimpan TER-HASH (SHA-256), berbatas waktu, sekali pakai — pola yang
/// sama persis dengan `password_reset_tokens`.
model Invitation {
  id Int @id @default(autoincrement())

  /// Tenant & PT tujuan. Disimpan dua-duanya walau company sudah menyiratkan
  /// tenant: kuota `max_users` dihitung per TENANT, dan penerimaan harus
  /// membuktikan keduanya masih serasi tanpa join tambahan.
  tenantId  Int     @map("tenant_id")
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId Int     @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Alamat yang diundang, huruf kecil. TIDAK unik: undangan lama yang hangus
  /// boleh berdampingan dengan yang baru — hanya yang termuda yang hidup
  /// (yang lama ditandai `used_at` saat yang baru terbit).
  email String @db.VarChar(255)

  /// Peran DI PT TUJUAN (nilai `roles.key` basis data perusahaan itu) — BUKAN
  /// peran tenant; penerima undangan selalu lahir sebagai tenant `member`.
  companyRole String @map("company_role") @db.VarChar(20)

  /// Pengundang — id pengguna global, untuk jejak. FK sengaja TIDAK dipasang:
  /// undangan harus tetap terbaca walau akun pengundangnya kelak dihapus.
  invitedByUserId Int @map("invited_by_user_id")

  /// SHA-256 hex dari token mentah; token mentah hanya hidup di dalam surel.
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  /// Terisi = sudah dipakai ATAU digantikan undangan yang lebih baru/dicabut.
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([companyId])
  @@index([email])
  @@index([expiresAt])
  @@map("invitations")
}

/// Pengguna × perusahaan × peran. Inilah yang tidak bisa dinyatakan oleh satu
/// kolom `users.role`: seseorang bisa Direktur Utama di PT A dan Kepala Gudang
/// di PT B, dan kedua kenyataan itu harus hidup berdampingan.
/// PENDAFTARAN MANDIRI yang belum terverifikasi (issue #138) — keadaan
/// "pending_verification" dari perjalanan §7.1 hidup DI SINI, bukan sebagai
/// baris `tenants`: Tenant + User(owner) + TenantMembership baru lahir — dalam
/// SATU transaksi — ketika tautan verifikasi diklik. Sebelum itu tidak ada
/// apa pun yang menempati email unik, tidak ada basis data yang dibuat, dan
/// pendaftaran yang ditinggalkan kedaluwarsa tanpa menyisakan akun setengah
/// jadi yang harus dibersihkan.
model Registration {
  id Int @id @default(autoincrement())

  /// BUKAN unik: orang boleh meminta ulang surel verifikasinya; token termuda
  /// yang menang (yang lama ditandai terpakai oleh permintaan baru).
  email String @db.VarChar(255)
  name  String @db.VarChar(100)

  /// bcrypt — kata sandi diketik sekali saat mendaftar dan langsung di-hash;
  /// nilai mentahnya tidak pernah disimpan di mana pun.
  passwordHash String @map("password_hash") @db.VarChar(255)

  /// SHA-256 hex token verifikasi (pola `password_reset_tokens`): token mentah
  /// hanya hidup di dalam surel.
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  /// Terisi = sudah diverifikasi ATAU digantikan permintaan yang lebih baru.
  usedAt    DateTime? @map("used_at")

  /// Jejak persetujuan S&K — kapan kotaknya dicentang (dikirim bersama form).
  termsAcceptedAt DateTime @map("terms_accepted_at")

  /// VERSI dokumen yang disetujui (issue #142) — "menyetujui S&K" tanpa versi
  /// tidak membuktikan apa-apa begitu dokumennya berubah. Nullable hanya untuk
  /// baris yang lahir sebelum kolomnya ada; alur daftar selalu mengisinya
  /// (nilai dari `lib/legal.ts`).
  termsVersion   String? @map("terms_version") @db.VarChar(30)
  privacyVersion String? @map("privacy_version") @db.VarChar(30)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([expiresAt])
  @@map("registrations")
}

/// PERMINTAAN PENGHAPUSAN AKUN (issue #142, UU PDP) — penghapusan TIDAK PERNAH
/// terjadi dari satu tombol: baris ini hanyalah PERMINTAAN eksplisit, dengan
/// masa tenggang untuk berubah pikiran, dan EKSEKUSINYA di tangan operator
/// lewat skrip bergerbang bukti (scripts/execute-tenant-deletion.ts — pola
/// adopsi #134). Buku besar TIDAK dihapus oleh eksekusi: UU KUP menuntut
/// retensi 10 tahun; yang terjadi adalah penonaktifan + anonimisasi data
/// pribadi, dan penghancuran buku baru boleh SETELAH `retention_until`
/// (docs/COMPLIANCE.md).
model TenantDeletionRequest {
  id       Int @id @default(autoincrement())
  tenantId Int @map("tenant_id")

  /// Id pengguna GLOBAL peminta — sengaja TANPA FK (pola periods.closed_by_id):
  /// eksekusi menganonimkan pengguna, dan permintaan harus tetap terbaca
  /// sebagai jejak sesudahnya.
  requestedByUserId Int @map("requested_by_user_id")

  /// pending | cancelled | executed (`DELETION_REQUEST_STATUSES`,
  /// lib/tenant-deletion.ts).
  status String @default("pending") @db.VarChar(20)

  /// Akhir masa tenggang — sebelum ini lewat, eksekusi DITOLAK skripnya.
  graceEndsAt DateTime  @map("grace_ends_at")
  cancelledAt DateTime? @map("cancelled_at")
  executedAt  DateTime? @map("executed_at")

  /// Batas retensi UU KUP, dihitung SAAT eksekusi dari tanggal jurnal termuda
  /// + 10 tahun. Sebelum lewat, penghancuran buku (--drop-ledgers) ditolak.
  retentionUntil DateTime? @map("retention_until")

  /// Alasan dari peminta (opsional) — membantu operator menimbang.
  note String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@map("tenant_deletion_requests")
}

/// Penghitung pembatas laju PERSISTEN (issue #138) — `lib/rate-limit.ts` yang
/// lama menghitung di `Map` memori: hilang saat proses dimulai ulang dan tidak
/// terbagi antar-instance. Untuk /login internal itu diterima; untuk endpoint
/// yang TERBUKA KE INTERNET (/register, atur-ulang kata sandi) tidak. Baris =
/// satu kunci (mis. `register:ip:1.2.3.4`) dengan jendela tetap; penambahannya
/// atomik lewat `INSERT … ON DUPLICATE KEY UPDATE` (lib/rate-limit-persistent.ts).
model RateLimitCounter {
  id Int @id @default(autoincrement())

  key             String   @unique @db.VarChar(160)
  windowStartedAt DateTime @map("window_started_at")
  count           Int      @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([updatedAt])
  @@map("rate_limit_counters")
}

model Membership {
  id        Int @id @default(autoincrement())
  userId    Int @map("user_id")
  companyId Int @map("company_id")

  /// Peran DI PERUSAHAAN INI. Nilainya sama dengan `users.role` yang lama
  /// (managing_director | finance_manager | warehouse_head | administrator, plus
  /// peran kustom) — tapi peran kustom adalah DATA di basis data perusahaan
  /// (tabel `roles`), jadi nilai di sini hanya sah untuk perusahaan itu.
  role String @db.VarChar(20)

  /// Preferensi tampilan "Mode Akuntan" (issue #11). NULL = ikut bawaan peran.
  /// Milik KEANGGOTAAN, bukan pengguna: bawaannya diturunkan dari peran, dan
  /// peran berbeda per perusahaan — orang yang sama bisa butuh permukaan
  /// akuntansi di PT A dan tidak di PT B.
  accountantMode Boolean? @map("accountant_mode")

  /// Dicabut aksesnya ke perusahaan ini tanpa menghapus jejak bahwa ia pernah
  /// punya. Menghapus baris juga sah untuk keanggotaan yang salah buat.
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Satu peran per (pengguna, perusahaan). Dua peran di satu perusahaan bukan
  /// keadaan yang bisa dijawab penjaga izin tanpa menebak.
  @@unique([userId, companyId])
  @@index([companyId])
  @@index([isActive])
  @@map("memberships")
}

// ─── Token API (issue #389 — F-10 lapis 1) ───────────────
/// Kredensial mesin untuk membaca buku SATU perusahaan lewat `/api/v1/…`.
///
/// ══ KENAPA DI BASIS DATA KENDALI ═══════════════════════════════════════════
/// Ia menjawab pertanyaan yang sama dengan `memberships`: "siapa boleh membuka
/// buku mana, sebagai apa". Pertanyaan itu selalu dijawab kendali — buku
/// perusahaan tidak boleh memuat kredensial yang bisa membuka dirinya sendiri,
/// sebab satu SELECT di sana akan membawa pergi kuncinya.
///
/// ══ TOKENNYA TIDAK PERNAH DISIMPAN ═════════════════════════════════════════
/// Yang tersimpan SHA-256-nya. Bentuk tokennya `sai_<id>_<rahasia>`: `id`
/// dipakai MENCARI barisnya (satu kueri berindeks, bukan memindai seluruh
/// tabel dan membandingkan hash satu per satu), `rahasia` yang di-hash.
///
/// SHA-256, BUKAN bcrypt — dan itu bukan kelalaian. bcrypt sengaja lambat untuk
/// menahan penebakan kata sandi manusia yang entropinya rendah; rahasia di sini
/// 32 byte acak, dan menebaknya mustahil tanpa bantuan pelambatan apa pun.
/// Memakai bcrypt di sini berarti membayar ~100 ms pada SETIAP permintaan API
/// untuk keamanan yang tidak bertambah.
model ApiToken {
  id        Int @id @default(autoincrement())
  companyId Int @map("company_id")

  /// Nama yang ditulis manusia ("Integrasi kasir", "Laporan mingguan") — supaya
  /// mencabut token berarti mencabut sesuatu yang bisa dikenali, bukan sebuah id.
  name String @db.VarChar(100)

  /// SHA-256 heksadesimal dari bagian rahasianya. 64 karakter, selalu.
  tokenHash String @map("token_hash") @db.VarChar(64)

  /// Peran yang DIPERANKAN token ini di perusahaan itu.
  ///
  /// Bukan daftar cakupan tersendiri, dan itu keputusan: matriks izin sudah
  /// menjawab "peran apa boleh apa", termasuk override per perusahaan
  /// (issue #73). Daftar cakupan kedua di sebelahnya akan menyimpang dari
  /// matriks itu pada perubahan izin pertama — dan yang menyimpang selalu yang
  /// lebih jarang dibaca.
  role String @db.VarChar(20)

  /// Siapa yang menerbitkannya. Id global (basis data ini), jadi FK-nya sah.
  createdByUserId Int @map("created_by_user_id")

  /// Kapan terakhir dipakai — satu-satunya cara pemiliknya tahu token mana yang
  /// sudah tidak dipakai siapa pun dan aman dicabut. Ditulis paling banyak
  /// sekali per menit; lihat `lib/api-token.ts`.
  lastUsedAt DateTime? @map("last_used_at")

  /// Dicabut. Baris TIDAK dihapus: token yang pernah menarik data pelanggan
  /// harus tetap bisa dijawab "siapa yang menerbitkannya, dan kapan dicabut".
  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([revokedAt])
  @@map("api_tokens")
}

/// Pemberitahuan DALAM APLIKASI untuk satu pengguna.
///
/// ══ KENAPA ADA ═════════════════════════════════════════════════════════════
/// Empat perusahaan mandek di wisaya penyiapan selama enam hari (issue #416) dan
/// tidak ada satu pun kanal yang memberi tahu siapa pun — tidak pemiliknya,
/// tidak operatornya. Bahkan setelah diperbaiki, satu-satunya cara mengabari
/// mereka adalah surel yang dikirim tangan.
///
/// ══ KENAPA DI BASIS DATA KENDALI ═══════════════════════════════════════════
/// Pemberitahuan milik PENGGUNA, dan pengguna hidup di kendali sejak #104.
/// Menaruhnya di buku perusahaan berarti orang yang punya dua PT punya dua
/// kotak masuk yang tak pernah bertemu — dan pemberitahuan yang paling penting
/// (penyiapan belum selesai) justru lahir SEBELUM ada buku yang bisa dibaca.
///
/// ══ IDEMPOTEN LEWAT `dedupe_key` ═══════════════════════════════════════════
/// `@@unique([userId, kind, dedupeKey])` — doktrin yang sama dengan
/// `ReminderLog` (#140): produser yang berjalan dua kali MENABRAK constraint,
/// bukan melahirkan pemberitahuan kembar. Penjadwal yang jalan tiap jam karena
/// itu aman memanggilnya tiap jam.
model Notification {
  id Int @id @default(autoincrement())

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// enum-like: setup_incomplete | … — `String @db.VarChar` + z.enum,
  /// konvensi docs/DATABASE.md. Menentukan ikon & pengelompokan, bukan izin.
  kind String @db.VarChar(40)

  title String @db.VarChar(150)
  body  String @db.VarChar(1000)

  /// Tautan DALAM aplikasi (mis. `/t/acme/pt-a/setup`). NULL = tidak menuju
  /// ke mana pun — pemberitahuan yang hanya memberi kabar.
  href String? @db.VarChar(255)

  /// Kunci idempotensi milik produser. Lihat catatan di kepala model.
  dedupeKey String @map("dedupe_key") @db.VarChar(120)

  /// NULL = belum dibaca. Waktu, bukan boolean: "kapan dibaca" adalah
  /// pertanyaan yang selalu muncul berikutnya, dan boolean tidak bisa
  /// menjawabnya tanpa migration kedua.
  readAt DateTime? @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@unique([userId, kind, dedupeKey])
  @@index([userId, readAt])
  @@map("notifications")
}
